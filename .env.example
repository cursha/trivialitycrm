DATABASE_URL="postgresql://trivialitycrm:trivialitycrm@localhost:5432/trivialitycrm"

# Separate database for automated tests. Vitest refuses to run destructive
# setup against anything else — never point this at DATABASE_URL.
TEST_DATABASE_URL="postgresql://trivialitycrm:trivialitycrm@localhost:5433/trivialitycrm_test"

# Bootstrap Administrator, created by `prisma db seed` only when BOTH values
# below are supplied. Leave blank to skip bootstrap-admin creation (e.g. in
# CI, or after the first admin already exists). Never commit real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""


# AI-assisted research provider (Module Two). "mock" is the safe default —
# no network calls, no cost — and is what automated tests always use
# regardless of this value (see .env.test). Set to "anthropic" and supply
# AI_API_KEY to use live AI-assisted research. See MODULE_2_REPORT.md for
# provider options/costs/legal considerations that were evaluated.
AI_PROVIDER="mock"
AI_API_KEY=""

# Optional spend guardrails for live AI usage (Module Three). Unset means no
# cap. Checked by the worker before it starts a queued search job.
AI_DAILY_BUDGET_USD=""
AI_MONTHLY_BUDGET_USD=""

AUTH_SECRET="replace-with-a-long-random-value"

# Public base URL of this deployment (e.g. https://crm.example.com). Required
# once NODE_ENV=production — used for the CSP/server-actions trusted-origin
# allowlist. Not needed for local dev.
APP_URL=""

# Next.js encrypts Server Action closures before sending them to the client.
# Required once NODE_ENV=production — must be a stable value shared across
# every web instance/restart (Next's own docs: otherwise a self-hosted
# multi-instance deployment can generate a different key per instance).
# Never commit a real value; generate one with `openssl rand -base64 32`.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# How long an uploaded-but-not-yet-imported spreadsheet batch (Module Three's
# durable replacement for the old in-memory preview store) is kept before the
# worker's cleanup job wipes it. Defaults to 4 hours; keep this short — it's
# staged contact/company data.
IMPORT_BATCH_TTL_HOURS="4"

# Optional error-reporting sink. Unset means errors are only logged via the
# structured logger — no third-party dependency is required. Never commit a
# real value.
SENTRY_DSN=""
