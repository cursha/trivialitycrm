DATABASE_URL="postgresql://trivialitycrm:trivialitycrm@localhost:5432/trivialitycrm"

# Separate database for automated tests. Vitest refuses to run destructive
# setup against anything else — never point this at DATABASE_URL.
TEST_DATABASE_URL="postgresql://trivialitycrm:trivialitycrm@localhost:5433/trivialitycrm_test"

# Bootstrap Administrator, created by `prisma db seed` only when BOTH values
# below are supplied. Leave blank to skip bootstrap-admin creation (e.g. in
# CI, or after the first admin already exists). Never commit real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""


# AI-assisted research provider (Module Two). "mock" is the safe default —
# no network calls, no cost — and is what automated tests always use
# regardless of this value (see .env.test). Set to "anthropic" and supply
# AI_API_KEY to use live AI-assisted research. See MODULE_2_REPORT.md for
# provider options/costs/legal considerations that were evaluated.
AI_PROVIDER="mock"
AI_API_KEY=""

AUTH_SECRET="replace-with-a-long-random-value"
