DATABASE_URL="postgresql://trivialitycrm:trivialitycrm@localhost:5432/trivialitycrm"

# Separate database for automated tests. Vitest refuses to run destructive
# setup against anything else — never point this at DATABASE_URL.
TEST_DATABASE_URL="postgresql://trivialitycrm:trivialitycrm@localhost:5433/trivialitycrm_test"

# Bootstrap Administrator, created by `prisma db seed` only when BOTH values
# below are supplied. Leave blank to skip bootstrap-admin creation (e.g. in
# CI, or after the first admin already exists). Never commit real values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""


# AI-assisted research provider (Module Two). "mock" is the safe default —
# no network calls, no cost — and is what automated tests always use
# regardless of this value (see .env.test). Set to "anthropic" and supply
# AI_API_KEY to use live AI-assisted research. See MODULE_2_REPORT.md for
# provider options/costs/legal considerations that were evaluated.
AI_PROVIDER="mock"
AI_API_KEY=""

# Optional spend guardrails for live AI usage (Module Three). Module 8A made
# these actually enforced (they were declared but unused before it) and
# added a DB-backed AiSettings row as the real runtime source of truth,
# editable from /administration/ai-settings without a redeploy. These two
# env vars are now only used to seed that row's *initial* value the first
# time `prisma db seed` runs against a fresh database — after that, edit the
# budget from the Administration UI, not here.
AI_DAILY_BUDGET_USD=""
AI_MONTHLY_BUDGET_USD=""

# Fast/cheap business-directory discovery for GENERAL-mode lead searches only
# (TRIVIA_GAP/TRIVIA_CONFIRMED/COMPETITOR modes always use the AI provider
# above — a directory API can't answer "does this place run trivia").
# "mock" is the safe default. Set to "google" + a real key from
# console.cloud.google.com (enable the "Places API (New)") to use real Google
# Places lookups. This is a separate account/billing setup from Anthropic.
PLACES_PROVIDER="mock"
GOOGLE_PLACES_API_KEY=""

# Public base URL of this deployment (e.g. https://crm.example.com). Required
# once NODE_ENV=production — used for the CSP/server-actions trusted-origin
# allowlist. Not needed for local dev.
APP_URL=""

# Next.js encrypts Server Action closures before sending them to the client.
# Required once NODE_ENV=production — must be a stable value shared across
# every web instance/restart (Next's own docs: otherwise a self-hosted
# multi-instance deployment can generate a different key per instance).
# Never commit a real value; generate one with `openssl rand -base64 32`.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Module Six: Communications. Encrypts OAuth tokens (ProviderConnection) at
# rest, AES-256-GCM (src/lib/comms/token-crypto.ts). Required once
# NODE_ENV=production. Never commit a real value; generate one with
# `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=""

# Module Six: Communications (Phase B). Signs {{unsubscribeLink}} tokens
# (src/lib/comms/unsubscribe-token.ts) — an HMAC secret, not an encryption
# key. Required once NODE_ENV=production. Never commit a real value;
# generate one with `openssl rand -base64 32`.
UNSUBSCRIBE_TOKEN_SECRET=""

# Module Six: Communications. Azure AD app registration credentials for
# connecting Microsoft 365/Outlook mailboxes via OAuth. Leave both blank to
# disable the Microsoft provider — connecting a Microsoft mailbox will show
# as unavailable rather than erroring. Never commit real values.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Module Six: Communications. Google Cloud OAuth client credentials for
# connecting Google Workspace/Gmail mailboxes. Leave both blank to disable
# the Google provider. Never commit real values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Module Nine: Integrations. Transactional/system email only — password
# reset links and an admin "send test email" action. Deliberately separate
# from MICROSOFT_CLIENT_ID/GOOGLE_CLIENT_ID above (Module Six's per-user
# OAuth mailbox sending for CRM outreach, unrelated to this setting). "mock"
# is the safe default — no network calls, no cost — and is what automated
# tests always use regardless of this value (see .env.test). Set to "resend"
# and supply RESEND_API_KEY to use live transactional email. Actual sending
# still stays off until an administrator enables it from
# /administration/integrations, even once this is configured.
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""

# Verified Resend sender address, e.g. "Triviality CRM <noreply@yourdomain.com>"
# — must be on a domain verified in the Resend dashboard. Required only once
# EMAIL_PROVIDER=resend.
RESEND_FROM_ADDRESS=""

# Verifies the Resend delivery-events webhook's signature. Required only
# once EMAIL_PROVIDER=resend. Never commit a real value.
RESEND_WEBHOOK_SECRET=""

# How long an uploaded-but-not-yet-imported spreadsheet batch (Module Three's
# durable replacement for the old in-memory preview store) is kept before the
# worker's cleanup job wipes it. Defaults to 4 hours; keep this short — it's
# staged contact/company data.
IMPORT_BATCH_TTL_HOURS="4"

# Optional error-reporting sink. Unset means errors are only logged via the
# structured logger — no third-party dependency is required. Never commit a
# real value.
SENTRY_DSN=""
