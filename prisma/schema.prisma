generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TriviaStatus {
  CURRENT_TRIVIA
  NO_CURRENT_TRIVIA
  UNCERTAIN
}

enum SearchResultDisposition {
  NEW
  REVIEWED
  TRANSFERRED
  REJECTED
  BELOW_SCORE
  DUPLICATE
}

enum SearchJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LeadSearchMode {
  TRIVIA_GAP
  TRIVIA_CONFIRMED
  COMPETITOR
  GENERAL
}

enum ActivityType {
  PHONE
  EMAIL
  MEETING
  MATERIAL_SENT
  DEMO
  TRIAL
  NOTE
  PIPELINE_CHANGE
  LEAD_TRANSFERRED
  ASSIGNMENT_CHANGE
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

// Optional flag on PipelineStage identifying the Won/Lost stage(s) without
// hardcoding a stage name anywhere in query logic — stage names are
// admin-editable free text (see PipelineStage.name), so any Won/Lost view
// or aggregate must key off this instead of a string match.
enum PipelineStageOutcome {
  WON
  LOST
}

enum SavedViewVisibility {
  PRIVATE
  SHARED
}

// Closed, rarely-changing set — unlike Lead Types/Pipeline Stages, which
// are genuinely admin-editable, a company's origin is one of a small fixed
// list. Nullable on Company: pre-Module-Five rows have no reliable source
// to backfill, so they stay null ("unknown/legacy") rather than guessed.
enum LeadSource {
  MANUAL
  AI_RESEARCH
  IMPORT
}

enum ReportCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum OpportunityGrade {
  A_PLUS
  A
  B
  C
  D
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum PrimaryClassification {
  ENTERTAINMENT_READY
  GREENFIELD
  REPLACEMENT
  NEEDS_QUALIFICATION
  EXISTING_CUSTOMER
}

enum SecondaryTag {
  EASY_WIN
  REVENUE_READY
  NO_HOST_READY
}

enum ScoringCategory {
  FOOD_BEVERAGE_FOCUS
  WEEKNIGHT_REVENUE_OPPORTUNITY
  COMMUNITY_ENGAGEMENT
  EXISTING_EVENT_CULTURE
  GROUP_SEATING_LAYOUT
  CAPACITY_OPERATIONAL_SUITABILITY
  DECISION_MAKER_ACCESSIBILITY
  MARKETING_ACTIVITY_VISIBILITY
  TURNKEY_IMPLEMENTATION_READINESS
  COMPETITIVE_OPPORTUNITY
}

enum EvidenceVerificationStatus {
  VERIFIED
  INFERRED
  UNVERIFIED
  OUTDATED
  CONTRADICTORY
}

enum EvidenceReliability {
  HIGH
  MEDIUM
  LOW
}

enum SearchCandidateStatus {
  PENDING
  VERIFIED
  SCORED
  COMPLETED
}

enum ImportBatchStatus {
  PENDING
  CONFIRMED
  IMPORTED
  EXPIRED
  FAILED
}

model User {
  id                       String                  @id @default(cuid())
  name                     String
  email                    String                  @unique
  passwordHash             String
  mustChangePassword       Boolean                 @default(false)
  disabled                 Boolean                 @default(false)
  failedLoginAttempts      Int                     @default(0)
  lockedUntil              DateTime?
  roleId                   String
  teamId                   String?
  role                     Role                    @relation(fields: [roleId], references: [id])
  team                     Team?                   @relation(fields: [teamId], references: [id])
  sessions                 Session[]
  assignedCompanies        Company[]               @relation("AssignedSalesperson")
  createdCompanies         Company[]               @relation("CompanyCreator")
  updatedCompanies         Company[]               @relation("CompanyUpdater")
  archivedCompanies        Company[]               @relation("CompanyArchiver")
  activities               Activity[]
  tasks                    Task[]                  @relation("TaskAssignee")
  prompts                  PromptTemplate[]
  searches                 LeadSearch[]
  importTemplates          ImportTemplate[]
  createdEvidence          EvidenceRecord[]        @relation("EvidenceCreator")
  scoredHistoricalRecords  HistoricalScoreRecord[] @relation("ScoreAuthor")
  importBatches            ImportBatch[]
  aiUsageRecords           AiUsageRecord[]
  territories              Territory[]             @relation("TerritoryAssignee")
  savedViews               SavedView[]
  stageHistoryChanges      PipelineStageHistory[]
  scheduledReports         ScheduledReport[]
  providerConnection       ProviderConnection?
  emailTemplatesOwned      EmailTemplate[]         @relation("EmailTemplateOwner")
  emailTemplatesCreated    EmailTemplate[]         @relation("EmailTemplateCreator")
  emailTemplatesUpdated    EmailTemplate[]         @relation("EmailTemplateUpdater")
  emailMessagesCreated     EmailMessage[]          @relation("EmailMessageCreator")
  emailMessagesReviewed    EmailMessage[]          @relation("EmailMessageReviewer")
  notifications            Notification[]
  consentRecordsRecorded   ConsentRecord[]
  followUpSequencesCreated FollowUpSequence[]
  sequenceEnrollmentsMade  SequenceEnrollment[]
  appointmentsCreated      Appointment[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  label String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  allowed      Boolean    @default(true)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model LeadType {
  id             String          @id @default(cuid())
  name           String          @unique
  active         Boolean         @default(true)
  sortOrder      Int             @default(0)
  companies      Company[]
  searches       LeadSearch[]
  emailTemplates EmailTemplate[]
}

model PipelineStage {
  id          String                @id @default(cuid())
  name        String                @unique
  active      Boolean               @default(true)
  isDefault   Boolean               @default(false)
  sortOrder   Int                   @default(0)
  outcomeType PipelineStageOutcome?
  companies   Company[]

  historyFrom       PipelineStageHistory[] @relation("StageHistoryFrom")
  historyTo         PipelineStageHistory[] @relation("StageHistoryTo")
  emailTemplates    EmailTemplate[]
  followUpSequences FollowUpSequence[]
}

model RejectionReason {
  id        String         @id @default(cuid())
  name      String         @unique
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  results   SearchResult[]

  lossHistoryEntries PipelineStageHistory[]
}

model Competitor {
  id            String         @id @default(cuid())
  name          String         @unique
  websiteUrl    String?
  active        Boolean        @default(true)
  companies     Company[]
  searches      LeadSearch[]
  searchResults SearchResult[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Company {
  id              String        @id @default(cuid())
  name            String
  normalizedName  String
  address1        String?
  city            String
  region          String
  postalCode      String?
  country         String
  phone           String?
  normalizedPhone String?
  email           String?
  normalizedEmail String?
  websiteUrl      String?
  websiteDomain   String?
  notes           String?       @db.Text
  aiScore         Int?
  aiExplanation   String?       @db.Text
  triviaStatus    TriviaStatus  @default(UNCERTAIN)
  nextFollowUpAt  DateTime?
  leadTypeId      String
  pipelineStageId String
  competitorId    String?
  // Nullable: a company can be unassigned (created without an owner, or
  // explicitly unassigned) — Module Four's "Unassigned Leads" view relies on
  // this. Never auto-cleared by any automated process; only an explicit
  // assign/reassign/unassign action changes it, always logging an
  // ASSIGNMENT_CHANGE Activity.
  assignedToId    String?
  createdById     String
  updatedById     String?
  leadType        LeadType      @relation(fields: [leadTypeId], references: [id])
  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id])
  competitor      Competitor?   @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  assignedTo      User?         @relation("AssignedSalesperson", fields: [assignedToId], references: [id])
  createdBy       User          @relation("CompanyCreator", fields: [createdById], references: [id])
  updatedBy       User?         @relation("CompanyUpdater", fields: [updatedById], references: [id])

  // Module Five: origin attribution. Nullable — set once at creation by
  // each of the three creation paths (manual add, AI transfer, import
  // commit); pre-existing rows stay null ("unknown/legacy") rather than
  // guessed. importBatchId is only ever set alongside source: IMPORT.
  source        LeadSource?
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // Archiving (soft delete). Companies are never hard-deleted except by an
  // Administrator permanently removing an already-archived record.
  status       CompanyStatus @default(ACTIVE)
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?         @relation("CompanyArchiver", fields: [archivedById], references: [id])

  // EOS-1.0 current/summary outputs. Category-level scores and full
  // scoring snapshots live only in HistoricalScoreRecord (append-only audit
  // trail); these fields are a denormalized "latest" view for fast listing.
  eosScore                 Int?
  opportunityGrade         OpportunityGrade?
  confidenceLevel          ConfidenceLevel?
  primaryClassification    PrimaryClassification?
  secondaryTags            SecondaryTag[]         @default([])
  salesPriorityScore       Int?
  scoreExplanation         String?                @db.Text
  verifiedEvidenceSummary  String?                @db.Text
  inferredEvidenceSummary  String?                @db.Text
  missingInformation       String?                @db.Text
  recommendedSalesApproach String?                @db.Text
  recommendedNextAction    String?                @db.Text
  lastScoredAt             DateTime?
  scoringVersion           String?
  isExistingCustomer       Boolean                @default(false)
  isQualified              Boolean                @default(false)
  exclusionReason          String?
  doNotContact             Boolean                @default(false)

  // Pointer to the single HistoricalScoreRecord considered "current" for
  // this company. @unique makes this a true one-to-one, so at most one
  // company can ever treat a given history row as current — this is the
  // sole source of truth for "current score", avoiding a duplicate/
  // conflicting `isCurrent` flag on the history table itself.
  currentHistoricalScoreId String?                 @unique
  currentHistoricalScore   HistoricalScoreRecord?  @relation("CurrentScore", fields: [currentHistoricalScoreId], references: [id], onDelete: SetNull)
  historicalScores         HistoricalScoreRecord[] @relation("CompanyScoreHistory")
  evidenceRecords          EvidenceRecord[]

  contacts            Contact[]
  activities          Activity[]
  tasks               Task[]
  sources             CompanySource[]
  searchResults       SearchResult[]
  stageHistory        PipelineStageHistory[]
  emailMessages       EmailMessage[]
  sequenceEnrollments SequenceEnrollment[]
  appointments        Appointment[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([normalizedName])
  @@index([websiteDomain])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([city, region, country])
  @@index([assignedToId, pipelineStageId])
  @@index([status])
  @@index([eosScore])
  @@index([opportunityGrade])
  @@index([primaryClassification])
  @@index([nextFollowUpAt])
  @@index([triviaStatus])
  @@index([source])
}

// Append-only, populated going forward only (no backfill — see
// MODULE_5_REPORT.md). Written inside the same transaction as the
// Activity.PIPELINE_CHANGE row it accompanies (src/lib/companies/
// activity-log.ts), plus once at company creation (fromStageId: null),
// so "time in stage" is computable from day one for every new company.
// This is the structured twin of the human-readable Activity log, purpose
// -built for reporting — the Activity log itself is untouched.
model PipelineStageHistory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fromStageId String? // null = company was just created
  fromStage   PipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     PipelineStage  @relation("StageHistoryTo", fields: [toStageId], references: [id])

  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  // Set only when moving into a Lost-outcome stage — reuses the existing
  // RejectionReason lookup table rather than a second "why did we lose
  // this" list.
  lossReasonId String?
  lossReason   RejectionReason? @relation(fields: [lossReasonId], references: [id])

  @@index([companyId, changedAt])
  @@index([toStageId])
}

// Territory matching against a Company is computed at query time from
// (country, region, city) — there is deliberately no territoryId on
// Company. A stored FK would go stale whenever a territory's scope is
// edited; computing the match on read keeps it always consistent with the
// current territory definitions. See src/lib/workspace/territory-match.ts.
model Territory {
  id           String   @id @default(cuid())
  name         String? // optional label, e.g. "Greater Toronto Area"
  country      String
  region       String? // null = whole country
  city         String? // null = whole region
  active       Boolean  @default(true)
  assignedToId String?
  assignedTo   User?    @relation("TerritoryAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Prevents two territories from ever covering the identical scope.
  // Hierarchical overlap (e.g. a country-level territory plus a city-level
  // territory within it) is allowed and resolved by specificity at match
  // time, not by this constraint.
  @@unique([country, region, city])
  @@index([assignedToId])
}

// A saved, reusable set of company-list filters. `filters` is a plain JSON
// object validated against SavedViewFiltersSchema (src/lib/workspace/
// saved-view-filters.ts) on every save AND every load-and-apply — never
// raw query text or anything executable.
model SavedView {
  id         String              @id @default(cuid())
  name       String
  ownerId    String
  owner      User                @relation(fields: [ownerId], references: [id])
  visibility SavedViewVisibility @default(PRIVATE)
  isDefault  Boolean             @default(false)
  filters    Json
  archivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  scheduledReports ScheduledReport[]

  @@index([ownerId])
}

// Single-row table (id fixed at 1) for the two configurable Sales Workspace
// thresholds. Edited from Settings, gated by the existing manage_settings
// permission — no new permission needed for this.
model WorkspaceSettings {
  id                         Int      @id @default(1)
  noActivityThresholdDays    Int      @default(14)
  newlyAssignedThresholdDays Int      @default(3)
  updatedAt                  DateTime @updatedAt

  // Module Six Phase B: CAN-SPAM requires a valid physical mailing address
  // in every commercial email — resolved via the {{sender.mailingAddress}}
  // template placeholder rather than hardcoded per-template.
  mailingAddress String?
}

// A report's filter configuration lives entirely in the existing SavedView
// (reused as-is, no changes to its schema or validated .strict() filter
// shape) — this table only carries what SavedView has no reason to hold:
// cadence, recipients, run status. See MODULE_5_REPORT.md for the
// scheduling design (one fixed hourly pg-boss tick + per-row dedup via
// singletonKey, not per-report native cron registration).
model ScheduledReport {
  id            String           @id @default(cuid())
  name          String
  reportKey     String // matches a /reports/[section] route, e.g. "pipeline" — never a stage/leadtype name
  savedViewId   String?
  savedView     SavedView?       @relation(fields: [savedViewId], references: [id])
  cadence       ReportCadence
  recipientIds  String[] // User ids, validated server-side against real users at save time
  active        Boolean          @default(true)
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  lastRunAt     DateTime?
  lastRunStatus ReportRunStatus?
  nextRunAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  generatedReports GeneratedReport[]

  @@index([active, nextRunAt])
  @@index([createdById])
}

// One row per actual report run — deliberately serves both roles Module
// Five needs ("store an in-app notification or downloadable report
// record"): seenByIds drives the notification-bell unread state, and the
// row (plus reportKey/scheduledReportId) is what a "download again" link
// re-runs against. Avoids a second, parallel Notification model.
model GeneratedReport {
  id                String           @id @default(cuid())
  scheduledReportId String? // null = ad-hoc/manual export, not from a schedule
  scheduledReport   ScheduledReport? @relation(fields: [scheduledReportId], references: [id])
  reportKey         String
  status            ReportRunStatus
  // The exact business-timezone period this run covers, resolved once at
  // generation time — a "download again" next month must reproduce what was
  // actually generated, not silently re-resolve "this month" to a different
  // month. Required on every row (this table has never received a row
  // before this field was added, so there is no backfill to reconcile).
  periodStart       DateTime
  periodEnd         DateTime
  // Frozen at generation time: { columns: {key,label}[], rows: Record<string,string>[] }
  // (the exact shape src/lib/export/serialize.ts's builders take) — makes
  // "download" a pure serialization of already-computed data, never a live
  // re-query that could drift from what was actually generated or leak data
  // the original scope no longer permits.
  payload           Json
  recipientIds      String[]
  seenByIds         String[]         @default([])
  errorMessage      String?
  createdAt         DateTime         @default(now())

  @@index([scheduledReportId])
  @@index([createdAt])
}

model Contact {
  id            String         @id @default(cuid())
  companyId     String
  firstName     String
  lastName      String
  title         String?
  phone         String?
  email         String?
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailMessages EmailMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Module Six Phase B: CASL-safe default-deny — a contact cannot receive
  // automated/composer email until a ConsentRecord establishes permission.
  // These two fields are a denormalized "current state" read alongside the
  // append-only ConsentRecord history, mirroring the exact
  // Company.currentHistoricalScoreId "current pointer" pattern from Module
  // One (full history in one table, fast current-state check on the row
  // itself).
  emailPermitted    Boolean         @default(false)
  doNotContact      Boolean         @default(false)
  unsubscribedAt    DateTime?
  unsubscribeSource String?
  consentRecords    ConsentRecord[]

  sequenceEnrollments SequenceEnrollment[]
  appointments        Appointment[]
}

model CompanySource {
  id         String   @id @default(cuid())
  companyId  String
  url        String
  title      String?
  evidence   String?
  verifiedAt DateTime
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model EvidenceRecord {
  id                 String                     @id @default(cuid())
  companyId          String
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           ScoringCategory
  sourceType         String?
  sourceUrl          String?
  evidenceSummary    String                     @db.Text
  evidenceDate       DateTime?
  verificationStatus EvidenceVerificationStatus @default(UNVERIFIED)
  reliability        EvidenceReliability        @default(MEDIUM)
  createdById        String
  createdBy          User                       @relation("EvidenceCreator", fields: [createdById], references: [id])
  createdAt          DateTime                   @default(now())

  @@index([companyId, category])
}

// Append-only audit trail of EOS-1.0 scoring runs. Rows here are never
// updated or deleted once written; Company.currentHistoricalScoreId points
// at whichever row is presently "current" for fast listing.
model HistoricalScoreRecord {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("CompanyScoreHistory", fields: [companyId], references: [id], onDelete: Cascade)

  // Back-reference for the Company.currentHistoricalScoreId pointer above.
  currentForCompany Company? @relation("CurrentScore")

  eosTotal                       Int
  foodBeverageFocus              Int
  weeknightRevenueOpportunity    Int
  communityEngagement            Int
  existingEventCulture           Int
  groupSeatingLayout             Int
  capacityOperationalSuitability Int
  decisionMakerAccessibility     Int
  marketingActivityVisibility    Int
  turnkeyImplementationReadiness Int
  competitiveOpportunity         Int

  opportunityGrade         OpportunityGrade
  confidenceLevel          ConfidenceLevel
  primaryClassification    PrimaryClassification
  secondaryTags            SecondaryTag[]        @default([])
  salesPriorityScore       Int?
  scoreExplanation         String?               @db.Text
  recommendedSalesApproach String?               @db.Text
  recommendedNextAction    String?               @db.Text
  scoringVersion           String
  scoredAt                 DateTime              @default(now())

  // Either a human reviewer (scoredBy) or a named automated source
  // (scoringSource, e.g. a future AI engine identifier) — at least one
  // should be set, enforced at the application layer.
  scoredById    String?
  scoredBy      User?   @relation("ScoreAuthor", fields: [scoredById], references: [id])
  scoringSource String?

  @@index([companyId, scoredAt])
}

model Activity {
  id         String       @id @default(cuid())
  companyId  String
  userId     String
  type       ActivityType
  occurredAt DateTime     @default(now())
  notes      String?      @db.Text
  outcome    String?
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())
}

model Task {
  id           String     @id @default(cuid())
  companyId    String
  assignedToId String
  title        String
  notes        String?
  dueAt        DateTime
  status       TaskStatus @default(OPEN)
  completedAt  DateTime?
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo   User       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model PromptTemplate {
  id                  String       @id @default(cuid())
  name                String
  qualificationPrompt String       @db.Text
  archived            Boolean      @default(false)
  createdById         String
  createdBy           User         @relation(fields: [createdById], references: [id])
  searches            LeadSearch[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model LeadSearch {
  id             String            @id @default(cuid())
  promptId       String?
  createdById    String
  leadTypeId     String
  competitorId   String?
  country        String
  region         String
  cities         Json
  minimumScore   Int               @default(80)
  mode           LeadSearchMode    @default(GENERAL)
  promptSnapshot String            @db.Text
  prompt         PromptTemplate?   @relation(fields: [promptId], references: [id], onDelete: SetNull)
  createdBy      User              @relation(fields: [createdById], references: [id])
  leadType       LeadType          @relation(fields: [leadTypeId], references: [id])
  competitor     Competitor?       @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  results        SearchResult[]
  candidates     SearchCandidate[]
  usageRecords   AiUsageRecord[]

  // Durable job tracking — executed by the worker via a pg-boss job
  // (providerJobId), not inline in the web process. See run-search.ts and
  // worker/handlers/run-search.ts.
  status          SearchJobStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  heartbeatAt     DateTime?
  errorMessage    String?         @db.Text
  candidatesFound Int             @default(0)
  providerJobId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, heartbeatAt])
  @@index([providerJobId])
}

/**
 * One row per candidate returned by a single discover() call for a
 * LeadSearch, persisted immediately so the expensive/non-deterministic
 * discovery step is never re-run once its results are checkpointed. Status
 * advances PENDING -> VERIFIED -> SCORED -> COMPLETED as run-search.ts
 * processes each candidate; a resumed/retried job skips everything already
 * COMPLETED and re-enters at the first un-checkpointed stage, so a crash mid
 * -job can cause at most one extra provider call per candidate per retry,
 * never a duplicate SearchResult row (see SearchResult.candidateId).
 */
model SearchCandidate {
  id                 String                @id @default(cuid())
  searchId           String
  search             LeadSearch            @relation(fields: [searchId], references: [id], onDelete: Cascade)
  index              Int
  normalizedIdentity String
  rawCandidate       Json
  status             SearchCandidateStatus @default(PENDING)
  verifiedData       Json?
  score              Int?
  explanation        String?               @db.Text
  attempts           Int                   @default(0)
  lastError          String?               @db.Text
  result             SearchResult?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([searchId, normalizedIdentity])
  @@index([searchId, status])
}

model SearchResult {
  id                String                  @id @default(cuid())
  searchId          String
  companyId         String?
  rejectionReasonId String?
  competitorId      String?
  // Links back to the SearchCandidate this result was created from. Nullable
  // because rows created before this column existed have no candidate row;
  // every new result is upserted by candidateId so a retried job can never
  // create a duplicate (see SearchCandidate doc comment).
  candidateId       String?                 @unique
  candidate         SearchCandidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  name              String
  address1          String?
  city              String
  region            String
  postalCode        String?
  country           String
  phone             String?
  email             String?
  websiteUrl        String?
  contactData       Json?
  score             Int
  explanation       String                  @db.Text
  // Structured convention (no schema-level shape, defined at the app layer):
  // evidence = { category, note, sourceUrl, verificationStatus }[]
  // sources  = { url, title }[] flat citation list for quick display
  evidence          Json
  sources           Json
  triviaStatus      TriviaStatus            @default(UNCERTAIN)
  disposition       SearchResultDisposition @default(NEW)
  researchedAt      DateTime                @default(now())
  search            LeadSearch              @relation(fields: [searchId], references: [id], onDelete: Cascade)
  company           Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  rejectionReason   RejectionReason?        @relation(fields: [rejectionReasonId], references: [id], onDelete: SetNull)
  competitor        Competitor?             @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  // Mirrors Company's normalized columns — powers cross-search rejection
  // memory (findPriorRejectedMatches) since candidates aren't Company rows
  // yet when this matching needs to happen.
  normalizedName  String
  normalizedPhone String?
  normalizedEmail String?
  websiteDomain   String?

  @@index([searchId, score])
  @@index([normalizedName])
  @@index([websiteDomain])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([disposition])
}

model ImportTemplate {
  id              String   @id @default(cuid())
  name            String
  mapping         Json
  transformations Json?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/**
 * Durable replacement for the old in-memory upload preview store. `payload`
 * (the parsed spreadsheet rows) is nulled the moment it's no longer needed —
 * immediately after a successful commitImport, or by the worker's cleanup
 * job once expiresAt passes for a batch nobody committed. The row itself
 * (metadata only, once payload is null) is kept a further grace period for
 * troubleshooting, then hard-deleted. Never written with app-layer
 * encryption — see MODULE_3_REPORT.md for why plain Json was chosen.
 */
model ImportBatch {
  id           String            @id @default(cuid())
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  filename     String
  status       ImportBatchStatus @default(PENDING)
  headers      Json
  payload      Json?
  rowCount     Int
  mapping      Json?
  errorMessage String?           @db.Text
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  companies    Company[]

  @@index([status, expiresAt])
  @@index([uploadedById])
}

/**
 * One row per AI provider call (discover/verify/score/promptAssist),
 * written immediately after the call returns so cost is visible even if the
 * enclosing job later fails. Feeds the optional AI_DAILY_BUDGET_USD /
 * AI_MONTHLY_BUDGET_USD safeguard — see src/lib/research/providers/pricing.ts.
 */
model AiUsageRecord {
  id                  String      @id @default(cuid())
  searchId            String?
  search              LeadSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider            String
  operation           String
  model               String
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int         @default(0)
  cacheCreationTokens Int         @default(0)
  serverToolUses      Int         @default(0)
  estimatedCostUsd    Decimal     @db.Decimal(10, 6)
  createdAt           DateTime    @default(now())

  @@index([createdAt])
  @@index([searchId])
}

/**
 * Fixed-window Postgres counter, shared by every process (web + every
 * worker instance) — replaces the old in-process, restart-losing token
 * bucket. key encodes the axis being limited, e.g. "login:ip:<ip>" or
 * "ai-provider:anthropic". See src/lib/rate-limit/postgres-bucket.ts.
 */
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}

// ===== Module Six: Communications and Follow-up Automation (Phases A-B) =====

enum ProviderKind {
  MICROSOFT
  GOOGLE
}

enum ProviderConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

/**
 * One connected mailbox per user (unique on userId) — the brief's "connect
 * their own business mailbox," never a shared company mailbox. Microsoft
 * and Google both grant mail + calendar scopes in a single OAuth consent,
 * so this one row covers calendar access too (Phase D) rather than a
 * second connection model. Tokens are encrypted at rest
 * (src/lib/comms/token-crypto.ts, AES-256-GCM) — this table never stores a
 * plaintext token. tokenEncryptionKeyVersion supports rotating
 * TOKEN_ENCRYPTION_KEY later without a flag day.
 */
model ProviderConnection {
  id                        String                   @id @default(cuid())
  userId                    String                   @unique
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                  ProviderKind
  providerAccountEmail      String
  encryptedAccessToken      String                   @db.Text
  encryptedRefreshToken     String                   @db.Text
  tokenEncryptionKeyVersion Int                      @default(1)
  scopes                    String[]
  tokenExpiresAt            DateTime
  status                    ProviderConnectionStatus @default(CONNECTED)
  lastError                 String?
  lastSyncAt                DateTime?
  connectedAt               DateTime                 @default(now())
  disconnectedAt            DateTime?

  // Module Six Phase D2: inbound sync. inboundClientState is a per-
  // connection random secret this app generates and hands to the provider
  // when creating the subscription; the provider echoes it back on every
  // notification, and the webhook route rejects anything that doesn't
  // match — proof the notification actually came from a subscription this
  // app created, not a forged POST to the public webhook URL. It's a
  // shared secret analogous to a webhook signing secret, not a bearer
  // credential to the mailbox itself, so unlike the access/refresh tokens
  // above it isn't run through token-crypto.ts. Only ever populated for
  // Microsoft connections in this phase — see google.ts's inbound methods.
  inboundSubscriptionId        String?
  inboundSubscriptionExpiresAt DateTime?
  inboundClientState           String?

  emailMessages EmailMessage[]
  appointments  Appointment[]

  @@index([status])
}

enum EmailTemplateVisibility {
  PERSONAL
  SHARED
}

/**
 * Table-driven, editable templates — never hardcoded copy. Placeholder
 * syntax and unresolved-placeholder detection live in
 * src/lib/comms/templates.ts (a pure function, unit-tested standalone,
 * same spirit as src/lib/reports/metrics.ts). ownerId is null for a shared
 * template (visibility SHARED); set for a personal one.
 */
model EmailTemplate {
  id              String                  @id @default(cuid())
  name            String
  category        String?
  subject         String
  body            String                  @db.Text
  active          Boolean                 @default(true)
  visibility      EmailTemplateVisibility @default(PERSONAL)
  ownerId         String?
  owner           User?                   @relation("EmailTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  leadTypeId      String?
  leadType        LeadType?               @relation(fields: [leadTypeId], references: [id], onDelete: SetNull)
  pipelineStageId String?
  pipelineStage   PipelineStage?          @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  language        String                  @default("en")
  createdById     String
  createdBy       User                    @relation("EmailTemplateCreator", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?                   @relation("EmailTemplateUpdater", fields: [updatedById], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  emailMessages EmailMessage[]
  sequenceSteps SequenceStep[]

  @@index([visibility, active])
  @@index([ownerId])
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailMessageStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
  REPLIED
  // Module Six Phase D2: an inbound message that arrived via webhook sync.
  // Deliberately its own value rather than overloading DELIVERED (which
  // means "an outbound send was confirmed delivered") or REPLIED (reserved
  // for a display-layer "this outbound message got a reply" marker, not
  // implemented yet) — see the inbound-sync doc comment below.
  RECEIVED
}

/**
 * One row per email in either direction — this is what the company/contact
 * Inbox tab renders, and (from Phase E) what delivery-status webhooks
 * update in place. Deliberately separate from Activity (the human-readable
 * audit trail already logs a plain-language "email sent" note via
 * logEmailSent — see src/lib/companies/activity-log.ts's existing
 * convention) — same split Module Five established for
 * PipelineStageHistory vs. the PIPELINE_CHANGE activity.
 * Phase D2 (inbound sync): companyId/contactId are nullable because an
 * inbound message from a sender address matching no Contact (or matching
 * more than one, across different companies) can't be attached to
 * anything yet — it lands with both null and reviewedAt/reviewedById null,
 * for authorized review at /settings/communications-review (the plan's
 * explicit "never auto-create a company from an unknown sender"
 * requirement). fromAddress is the raw inbound sender; null for outbound
 * rows, where the sender is implied by providerConnection.
 */
model EmailMessage {
  id                   String              @id @default(cuid())
  companyId            String?
  company              Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId            String?
  contact              Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  direction            EmailDirection      @default(OUTBOUND)
  providerConnectionId String?
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  fromAddress          String?
  toAddresses          String[]
  ccAddresses          String[]            @default([])
  bccAddresses         String[]            @default([])
  subject              String
  body                 String              @db.Text
  templateId           String?
  template             EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status               EmailMessageStatus  @default(DRAFT)
  scheduledFor         DateTime?
  sentAt               DateTime?
  providerMessageId    String?
  providerThreadId     String?
  errorMessage         String?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?               @relation("EmailMessageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?               @relation("EmailMessageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())

  sequenceStepRun SequenceStepRun?

  @@unique([providerConnectionId, providerMessageId])
  @@index([companyId])
  @@index([contactId])
  @@index([status, scheduledFor])
  @@index([direction, reviewedAt])
}

/**
 * Notification-level idempotency for inbound webhook delivery — a provider
 * may redeliver the same notification (Graph and Google both document this
 * as expected, not a bug), and this table makes a redelivery a cheap no-op
 * before any Graph/Google API call is even made to fetch the message
 * content. providerEventId is synthesized per provider (Graph doesn't
 * issue a single canonical notification id): see
 * src/lib/comms/inbound-sync.ts's buildWebhookEventId(). This is separate
 * from, and a first line of defense ahead of, EmailMessage's own
 * (providerConnectionId, providerMessageId) unique constraint, which
 * catches a duplicate at the message-content level too.
 */
model WebhookEvent {
  id              String       @id @default(cuid())
  provider        ProviderKind
  providerEventId String
  receivedAt      DateTime     @default(now())

  @@unique([provider, providerEventId])
}

enum ConsentType {
  EXPRESS
  IMPLIED
  WITHDRAWN
}

/**
 * Append-only — mirrors the exact HistoricalScoreRecord pattern from Module
 * One (full history here; Contact.emailPermitted/doNotContact are the
 * denormalized "current state" fields computed at write time, same split
 * as Company.currentHistoricalScoreId). A new record is never deleted or
 * edited, including a WITHDRAWN one from a self-service unsubscribe click
 * (recordedById is null in that case — no user performed the action).
 * This is compliance evidence, not just a status field: source/note/
 * occurredAt document *why* consent is believed to exist, for CASL/
 * CAN-SPAM record-keeping.
 */
model ConsentRecord {
  id           String      @id @default(cuid())
  contactId    String
  contact      Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type         ConsentType
  source       String
  note         String?
  occurredAt   DateTime    @default(now())
  recordedById String?
  recordedBy   User?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([contactId, occurredAt])
}

// ===== Module Six Phase C: scheduling and follow-up sequences =====

enum SequenceStepType {
  WAIT
  EMAIL
  TASK
  CALL_REMINDER
  DEMO_REMINDER
  TRIAL_FOLLOWUP
}

/**
 * A table-driven, admin-authored step list — never generated or recursive
 * — so a sequence terminates in at most `steps.length` ticks-worth of
 * processing (see the approved plan's "no uncontrolled loops" requirement).
 * WAIT has no side effect of its own; it only delays how long after the
 * previous step the next actionable (EMAIL/TASK-like) step becomes due —
 * see src/lib/comms/sequences.ts for the due-date computation. The other
 * five types are "actionable": EMAIL sends via the same sendEmail() gate
 * every other send path shares; the four TASK-like types create a real
 * Task row (src/app/(dashboard)/companies/[id]/tasks), reusing the
 * existing follow-up infrastructure rather than a parallel one.
 */
model SequenceStep {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepOrder  Int
  type       SequenceStepType

  waitDays        Int?
  emailTemplateId String?
  emailTemplate   EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  taskTitle       String?
  taskNotes       String?        @db.Text

  stepRuns SequenceStepRun[]

  @@unique([sequenceId, stepOrder])
}

/**
 * A sequence-level (not per-step) stop condition: reaching this pipeline
 * stage ends every active enrollment in this sequence, checked by the tick
 * before running any step (src/lib/comms/sequences.ts). Kept at the
 * sequence level rather than duplicated per step — the plan's schema
 * sketch put this on SequenceStep, but "which stage ends the sequence" is
 * one decision per sequence, not one the author should have to repeat on
 * every step.
 */
model FollowUpSequence {
  id                    String         @id @default(cuid())
  name                  String
  active                Boolean        @default(true)
  stopOnPipelineStageId String?
  stopOnPipelineStage   PipelineStage? @relation(fields: [stopOnPipelineStageId], references: [id], onDelete: SetNull)
  createdById           String
  createdBy             User           @relation(fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

enum SequenceEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  STOPPED_OPT_OUT
  STOPPED_STAGE
  STOPPED_REPLY
}

/**
 * Explicit enrollment only — created by a user action after previewing
 * every step (no automatic/batch enrollment path anywhere in this schema).
 * `currentStepOrder` always points at the next actionable step to run;
 * `nextStepDueAt` is when the tick should run it. `STOPPED_REPLY` exists
 * on the enum for schema completeness across the whole plan but is
 * unreachable until Phase D adds inbound reply detection — this phase can
 * only ever produce STOPPED_OPT_OUT/STOPPED_STAGE, never STOPPED_REPLY.
 */
model SequenceEnrollment {
  id         String                   @id @default(cuid())
  sequenceId String
  sequence   FollowUpSequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status     SequenceEnrollmentStatus @default(ACTIVE)

  currentStepOrder Int
  nextStepDueAt    DateTime?

  enrolledById String
  enrolledBy   User      @relation(fields: [enrolledById], references: [id])
  enrolledAt   DateTime  @default(now())
  stoppedAt    DateTime?
  stopReason   String?

  stepRuns SequenceStepRun[]

  @@index([status, nextStepDueAt])
}

enum SequenceStepRunStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

/**
 * One row per attempted step, `@@unique([enrollmentId, stepId])` — the
 * duplicate-send-prevention mechanism, playing the exact role Module
 * Five's pg-boss `singletonKey` dedup plays for scheduled reports: a step
 * can be offered by multiple ticks (worker restart, slow processing)
 * without ever executing twice, without new locking code.
 */
model SequenceStepRun {
  id           String                @id @default(cuid())
  enrollmentId String
  enrollment   SequenceEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         SequenceStep          @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status       SequenceStepRunStatus @default(PENDING)
  runAt        DateTime              @default(now())

  emailMessageId String?       @unique
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  errorMessage   String?

  @@unique([enrollmentId, stepId])
}

// ===== Module Six Phase D1: calendar and appointments =====

enum AppointmentType {
  DEMO
  TRIAL_REVIEW
  FOLLOW_UP
}

enum AppointmentStatus {
  SCHEDULED
  UPDATED
  CANCELLED
  ERROR
}

/**
 * One appointment on a connected calendar (Microsoft/Google — same
 * ProviderConnection Phase A already established, since both providers
 * grant calendar scope in the same OAuth consent as mail). `startAt`/
 * `endAt` are real UTC instants; `timezone` (an IANA name) is what the
 * provider is told to display them in — Microsoft Graph specifically
 * requires wall-clock-in-that-zone strings, not UTC, for its event body
 * (see src/lib/comms/calendar-time.ts). `providerEventId` is null only
 * when creation itself failed (`status: ERROR`) — never claim a real
 * provider-side event exists when it doesn't.
 */
model Appointment {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type      AppointmentType
  title     String
  startAt   DateTime
  endAt     DateTime
  timezone  String

  attendeeEmails String[]

  providerConnectionId String?
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  providerEventId      String?
  status               AppointmentStatus   @default(SCHEDULED)
  lastError            String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([providerConnectionId])
}

enum NotificationType {
  NEW_REPLY
  DELIVERY_FAILURE
  APPOINTMENT_ACCEPTED
  APPOINTMENT_DECLINED
  SEQUENCE_COMPLETED
  SEQUENCE_PAUSED
  PROVIDER_DISCONNECTED
  FOLLOW_UP_DUE
  SCHEDULED_EMAIL_FAILED
}

/**
 * The general-purpose notification model this codebase didn't have before
 * (Module Five's GeneratedReport.seenByIds is deliberately report-specific
 * — see its own doc comment). payload carries type-specific display data
 * (e.g. { companyId, companyName } for NEW_REPLY) so the bell can render
 * and link without a second query per notification.
 */
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  payload     Json
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, readAt])
}
