generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TriviaStatus {
  CURRENT_TRIVIA
  NO_CURRENT_TRIVIA
  UNCERTAIN
}

enum SearchResultDisposition {
  NEW
  REVIEWED
  TRANSFERRED
  REJECTED
  BELOW_SCORE
  DUPLICATE
}

enum SearchJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LeadSearchMode {
  TRIVIA_GAP
  TRIVIA_CONFIRMED
  COMPETITOR
  GENERAL
}

enum ActivityType {
  PHONE
  EMAIL
  MEETING
  MATERIAL_SENT
  DEMO
  TRIAL
  NOTE
  PIPELINE_CHANGE
  LEAD_TRANSFERRED
  ASSIGNMENT_CHANGE
  // Module Seven: written on the surviving company when a duplicate company
  // is merged into it — the human-readable narrative twin of the structured
  // DataQualityAuditEvent, same split logPipelineChange already establishes
  // for PIPELINE_CHANGE/PipelineStageHistory.
  COMPANY_MERGED
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
  // Module Seven: a company absorbed into another via a safe merge. Distinct
  // from ARCHIVED (an intentional "set this aside" decision) — a MERGED
  // company was never rejected, it was subsumed into mergedIntoId, and its
  // data lives on there. Never hard-deleted; see mergedIntoId/mergedAt/
  // mergedById below.
  MERGED
}

// Optional flag on PipelineStage identifying the Won/Lost stage(s) without
// hardcoding a stage name anywhere in query logic — stage names are
// admin-editable free text (see PipelineStage.name), so any Won/Lost view
// or aggregate must key off this instead of a string match.
enum PipelineStageOutcome {
  WON
  LOST
}

enum SavedViewVisibility {
  PRIVATE
  SHARED
}

// Closed, rarely-changing set — unlike Lead Types/Pipeline Stages, which
// are genuinely admin-editable, a company's origin is one of a small fixed
// list. Nullable on Company: pre-Module-Five rows have no reliable source
// to backfill, so they stay null ("unknown/legacy") rather than guessed.
enum LeadSource {
  MANUAL
  AI_RESEARCH
  IMPORT
}

enum ReportCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum OpportunityGrade {
  A_PLUS
  A
  B
  C
  D
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum PrimaryClassification {
  ENTERTAINMENT_READY
  GREENFIELD
  REPLACEMENT
  NEEDS_QUALIFICATION
  EXISTING_CUSTOMER
}

enum SecondaryTag {
  EASY_WIN
  REVENUE_READY
  NO_HOST_READY
}

enum ScoringCategory {
  FOOD_BEVERAGE_FOCUS
  WEEKNIGHT_REVENUE_OPPORTUNITY
  COMMUNITY_ENGAGEMENT
  EXISTING_EVENT_CULTURE
  GROUP_SEATING_LAYOUT
  CAPACITY_OPERATIONAL_SUITABILITY
  DECISION_MAKER_ACCESSIBILITY
  MARKETING_ACTIVITY_VISIBILITY
  TURNKEY_IMPLEMENTATION_READINESS
  COMPETITIVE_OPPORTUNITY
}

enum EvidenceVerificationStatus {
  VERIFIED
  INFERRED
  UNVERIFIED
  OUTDATED
  CONTRADICTORY
}

enum EvidenceReliability {
  HIGH
  MEDIUM
  LOW
}

enum SearchCandidateStatus {
  PENDING
  VERIFIED
  SCORED
  COMPLETED
}

enum ImportBatchStatus {
  PENDING
  CONFIRMED
  IMPORTED
  EXPIRED
  FAILED
}

model User {
  id                       String                  @id @default(cuid())
  name                     String
  email                    String                  @unique
  passwordHash             String
  mustChangePassword       Boolean                 @default(false)
  disabled                 Boolean                 @default(false)
  failedLoginAttempts      Int                     @default(0)
  lockedUntil              DateTime?
  // Module 8A: set by recordSuccessfulLogin() (src/lib/auth/rate-limit.ts) —
  // never a security control by itself (lockout/failedLoginAttempts already
  // cover that), just a visibility field for admin account review.
  lastLoginAt              DateTime?
  roleId                   String
  teamId                   String?
  role                     Role                    @relation(fields: [roleId], references: [id])
  team                     Team?                   @relation(fields: [teamId], references: [id])
  sessions                 Session[]
  assignedCompanies        Company[]               @relation("AssignedSalesperson")
  createdCompanies         Company[]               @relation("CompanyCreator")
  updatedCompanies         Company[]               @relation("CompanyUpdater")
  archivedCompanies        Company[]               @relation("CompanyArchiver")
  activities               Activity[]
  tasks                    Task[]                  @relation("TaskAssignee")
  prompts                  PromptTemplate[]
  searches                 LeadSearch[]
  importTemplates          ImportTemplate[]
  createdEvidence          EvidenceRecord[]        @relation("EvidenceCreator")
  scoredHistoricalRecords  HistoricalScoreRecord[] @relation("ScoreAuthor")
  importBatches            ImportBatch[]
  aiUsageRecords           AiUsageRecord[]
  territories              Territory[]             @relation("TerritoryAssignee")
  savedViews               SavedView[]
  stageHistoryChanges      PipelineStageHistory[]
  scheduledReports         ScheduledReport[]
  providerConnection       ProviderConnection?
  emailTemplatesOwned      EmailTemplate[]         @relation("EmailTemplateOwner")
  emailTemplatesCreated    EmailTemplate[]         @relation("EmailTemplateCreator")
  emailTemplatesUpdated    EmailTemplate[]         @relation("EmailTemplateUpdater")
  emailMessagesCreated     EmailMessage[]          @relation("EmailMessageCreator")
  emailMessagesReviewed    EmailMessage[]          @relation("EmailMessageReviewer")
  notifications            Notification[]
  consentRecordsRecorded   ConsentRecord[]
  followUpSequencesCreated FollowUpSequence[]
  sequenceEnrollmentsMade  SequenceEnrollment[]
  appointmentsCreated      Appointment[]

  // Module Seven: Data Quality, Duplicate Management, Record Merging, and
  // Enrichment History.
  mergedCompanies             Company[]               @relation("CompanyMerger")
  mergedContacts              Contact[]               @relation("ContactMerger")
  dataQualityRulesCreated     DataQualityRule[]       @relation("DataQualityRuleCreator")
  dataQualityRulesUpdated     DataQualityRule[]       @relation("DataQualityRuleUpdater")
  dataQualityIssuesResolved   DataQualityIssue[]      @relation("DataQualityIssueResolver")
  dataQualityIssuesAssigned   DataQualityIssue[]      @relation("DataQualityIssueAssignee")
  potentialDuplicatesAssigned PotentialDuplicate[]    @relation("PotentialDuplicateAssignee")
  potentialDuplicatesReviewed PotentialDuplicate[]    @relation("PotentialDuplicateReviewer")
  dataQualityScansTriggered   DataQualityScan[]       @relation("DataQualityScanTrigger")
  enrichmentDecisions         EnrichmentRecord[]      @relation("EnrichmentDecider")
  dataQualityAuditEvents      DataQualityAuditEvent[] @relation("DataQualityAuditActor")

  // Module 8A: Essential Version 1 Administration.
  auditEvents               AuditEvent[]           @relation("AuditEventActor")
  organizationSettingsEdits OrganizationSettings[] @relation("OrganizationSettingsEditor")
  aiSettingsEdits           AiSettings[]           @relation("AiSettingsEditor")

  // Forgot-password: self-service reset requests and admin-generated links.
  passwordResetRequests         PasswordResetRequest[] @relation("PasswordResetRequestsForUser")
  passwordResetRequestsResolved PasswordResetRequest[] @relation("PasswordResetRequestsResolvedBy")
  passwordResetTokens           PasswordResetToken[]   @relation("PasswordResetTokensForUser")
  passwordResetTokensCreated    PasswordResetToken[]   @relation("PasswordResetTokensCreatedBy")

  // Module Nine: Essential Version 1 Integrations.
  integrationSettingsEdits IntegrationSettings[]       @relation("IntegrationSettingsEditor")
  transactionalEmailsSent  TransactionalEmailMessage[] @relation("TransactionalEmailSender")

  // Module Ten: first-login onboarding checklist.
  onboardingSteps UserOnboardingStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * One row per onboarding-checklist step a user has manually marked done
 * (see src/lib/onboarding/steps.ts for the fixed step catalog). Absence of
 * a row means "not done" — there is no separate "dismissed" state; the
 * checklist itself is always reachable from the shell regardless of
 * completion, so a step can be unchecked and rechecked freely.
 */
model UserOnboardingStep {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepKey     String
  completedAt DateTime @default(now())

  @@unique([userId, stepKey])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  // Module 8A: grouping/description for the Roles & Permissions UI.
  // Nullable so this is purely additive — an ungrouped/undescribed
  // permission (there shouldn't be any after the seed backfill) simply
  // renders without a category heading rather than erroring.
  category    String?
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  allowed      Boolean    @default(true)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model LeadType {
  id             String                 @id @default(cuid())
  name           String                 @unique
  active         Boolean                @default(true)
  sortOrder      Int                    @default(0)
  companies      Company[]
  searches       LeadSearch[]
  emailTemplates EmailTemplate[]
  orgDefaultFor  OrganizationSettings[]
}

model PipelineStage {
  id          String                @id @default(cuid())
  name        String                @unique
  active      Boolean               @default(true)
  isDefault   Boolean               @default(false)
  sortOrder   Int                   @default(0)
  outcomeType PipelineStageOutcome?
  companies   Company[]

  historyFrom       PipelineStageHistory[] @relation("StageHistoryFrom")
  historyTo         PipelineStageHistory[] @relation("StageHistoryTo")
  emailTemplates    EmailTemplate[]
  followUpSequences FollowUpSequence[]
  orgDefaultFor     OrganizationSettings[]
}

model RejectionReason {
  id        String         @id @default(cuid())
  name      String         @unique
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  results   SearchResult[]

  lossHistoryEntries PipelineStageHistory[]
}

model Competitor {
  id            String         @id @default(cuid())
  name          String         @unique
  websiteUrl    String?
  active        Boolean        @default(true)
  companies     Company[]
  searches      LeadSearch[]
  searchResults SearchResult[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Company {
  id                   String        @id @default(cuid())
  name                 String
  normalizedName       String
  address1             String?
  city                 String
  region               String
  postalCode           String?
  country              String
  phone                String?
  normalizedPhone      String?
  email                String?
  normalizedEmail      String?
  websiteUrl           String?
  websiteDomain        String?
  // Module Seven: address-matching normalization, computed by the new,
  // separate computeAddressNormalizedFields() (src/lib/data-quality/
  // normalize.ts) — deliberately NOT added to the existing
  // computeNormalizedFields() in src/lib/duplicates/match.ts, whose return
  // value is also spread onto SearchResult (a model with no matching
  // columns). Populated going forward at write time, self-healed by the
  // duplicate-quality scan for pre-existing rows — no SQL backfill
  // migration, same "populated going forward" precedent as
  // PipelineStageHistory. Original city/region/postalCode display values
  // are never overwritten.
  normalizedRegion     String?
  normalizedCity       String?
  normalizedPostalCode String?
  notes                String?       @db.Text
  aiScore              Int?
  aiExplanation        String?       @db.Text
  triviaStatus         TriviaStatus  @default(UNCERTAIN)
  nextFollowUpAt       DateTime?
  leadTypeId           String
  pipelineStageId      String
  competitorId         String?
  // Nullable: a company can be unassigned (created without an owner, or
  // explicitly unassigned) — Module Four's "Unassigned Leads" view relies on
  // this. Never auto-cleared by any automated process; only an explicit
  // assign/reassign/unassign action changes it, always logging an
  // ASSIGNMENT_CHANGE Activity.
  assignedToId         String?
  createdById          String
  updatedById          String?
  leadType             LeadType      @relation(fields: [leadTypeId], references: [id])
  pipelineStage        PipelineStage @relation(fields: [pipelineStageId], references: [id])
  competitor           Competitor?   @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  assignedTo           User?         @relation("AssignedSalesperson", fields: [assignedToId], references: [id])
  createdBy            User          @relation("CompanyCreator", fields: [createdById], references: [id])
  updatedBy            User?         @relation("CompanyUpdater", fields: [updatedById], references: [id])

  // Module Five: origin attribution. Nullable — set once at creation by
  // each of the three creation paths (manual add, AI transfer, import
  // commit); pre-existing rows stay null ("unknown/legacy") rather than
  // guessed. importBatchId is only ever set alongside source: IMPORT.
  source        LeadSource?
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // Archiving (soft delete). Companies are never hard-deleted except by an
  // Administrator permanently removing an already-archived record.
  status       CompanyStatus @default(ACTIVE)
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?         @relation("CompanyArchiver", fields: [archivedById], references: [id])

  // Module Seven: merge tombstone, parallel in shape to archivedAt/
  // archivedById above. Set once, together with status: MERGED, by
  // mergeCompanies() (src/lib/data-quality/merge-company.ts) — never
  // cleared afterward. A merged company's own fields are left exactly as
  // they were at merge time (never overwritten/cleared) so its data remains
  // inspectable as history, not silently deleted. mergedIntoId can itself
  // point at a company that was later merged again — readers resolve the
  // chain to its final survivor (bounded-loop-safe) rather than assuming
  // one hop.
  mergedIntoId String?
  mergedInto   Company?  @relation("CompanyMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Company[] @relation("CompanyMerge")
  mergedAt     DateTime?
  mergedById   String?
  mergedBy     User?     @relation("CompanyMerger", fields: [mergedById], references: [id], onDelete: SetNull)

  // EOS-1.0 current/summary outputs. Category-level scores and full
  // scoring snapshots live only in HistoricalScoreRecord (append-only audit
  // trail); these fields are a denormalized "latest" view for fast listing.
  eosScore                 Int?
  opportunityGrade         OpportunityGrade?
  confidenceLevel          ConfidenceLevel?
  primaryClassification    PrimaryClassification?
  secondaryTags            SecondaryTag[]         @default([])
  salesPriorityScore       Int?
  scoreExplanation         String?                @db.Text
  verifiedEvidenceSummary  String?                @db.Text
  inferredEvidenceSummary  String?                @db.Text
  missingInformation       String?                @db.Text
  recommendedSalesApproach String?                @db.Text
  recommendedNextAction    String?                @db.Text
  lastScoredAt             DateTime?
  scoringVersion           String?
  isExistingCustomer       Boolean                @default(false)
  isQualified              Boolean                @default(false)
  exclusionReason          String?
  doNotContact             Boolean                @default(false)

  // Set only when an AI opportunity analysis (src/app/(dashboard)/companies/
  // opportunity-analysis.ts) finds something that contradicts existing,
  // trusted CRM data (e.g. the business appears closed, name doesn't
  // match) — it never silently overwrites the trusted field itself. Only
  // ever set to true by that path; only ever cleared by a human via
  // clearNeedsReview.
  needsReview       Boolean @default(false)
  needsReviewReason String? @db.Text

  // Pointer to the single HistoricalScoreRecord considered "current" for
  // this company. @unique makes this a true one-to-one, so at most one
  // company can ever treat a given history row as current — this is the
  // sole source of truth for "current score", avoiding a duplicate/
  // conflicting `isCurrent` flag on the history table itself.
  currentHistoricalScoreId String?                 @unique
  currentHistoricalScore   HistoricalScoreRecord?  @relation("CurrentScore", fields: [currentHistoricalScoreId], references: [id], onDelete: SetNull)
  historicalScores         HistoricalScoreRecord[] @relation("CompanyScoreHistory")
  evidenceRecords          EvidenceRecord[]

  contacts            Contact[]
  activities          Activity[]
  tasks               Task[]
  sources             CompanySource[]
  searchResults       SearchResult[]
  stageHistory        PipelineStageHistory[]
  emailMessages       EmailMessage[]
  sequenceEnrollments SequenceEnrollment[]
  appointments        Appointment[]

  // Module Seven: Data Quality, Duplicate Management, Record Merging, and
  // Enrichment History.
  dataQualityIssues    DataQualityIssue[]
  duplicatesAsA        PotentialDuplicate[]    @relation("PotentialDuplicateCompanyA")
  duplicatesAsB        PotentialDuplicate[]    @relation("PotentialDuplicateCompanyB")
  enrichmentRecords    EnrichmentRecord[]
  dataQualityAuditRefs DataQualityAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedName])
  @@index([websiteDomain])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([normalizedRegion])
  @@index([normalizedCity])
  @@index([normalizedPostalCode])
  @@index([city, region, country])
  @@index([assignedToId, pipelineStageId])
  @@index([status])
  @@index([mergedIntoId])
  @@index([eosScore])
  @@index([opportunityGrade])
  @@index([primaryClassification])
  @@index([nextFollowUpAt])
  @@index([triviaStatus])
  @@index([source])
}

// Append-only, populated going forward only (no backfill — see
// MODULE_5_REPORT.md). Written inside the same transaction as the
// Activity.PIPELINE_CHANGE row it accompanies (src/lib/companies/
// activity-log.ts), plus once at company creation (fromStageId: null),
// so "time in stage" is computable from day one for every new company.
// This is the structured twin of the human-readable Activity log, purpose
// -built for reporting — the Activity log itself is untouched.
model PipelineStageHistory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fromStageId String? // null = company was just created
  fromStage   PipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     PipelineStage  @relation("StageHistoryTo", fields: [toStageId], references: [id])

  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  // Set only when moving into a Lost-outcome stage — reuses the existing
  // RejectionReason lookup table rather than a second "why did we lose
  // this" list.
  lossReasonId String?
  lossReason   RejectionReason? @relation(fields: [lossReasonId], references: [id])

  @@index([companyId, changedAt])
  @@index([toStageId])
}

// Territory matching against a Company is computed at query time from
// (country, region, city) — there is deliberately no territoryId on
// Company. A stored FK would go stale whenever a territory's scope is
// edited; computing the match on read keeps it always consistent with the
// current territory definitions. See src/lib/workspace/territory-match.ts.
model Territory {
  id           String   @id @default(cuid())
  name         String? // optional label, e.g. "Greater Toronto Area"
  country      String
  region       String? // null = whole country
  city         String? // null = whole region
  active       Boolean  @default(true)
  assignedToId String?
  assignedTo   User?    @relation("TerritoryAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Prevents two territories from ever covering the identical scope.
  // Hierarchical overlap (e.g. a country-level territory plus a city-level
  // territory within it) is allowed and resolved by specificity at match
  // time, not by this constraint.
  @@unique([country, region, city])
  @@index([assignedToId])
}

// A saved, reusable set of company-list filters. `filters` is a plain JSON
// object validated against SavedViewFiltersSchema (src/lib/workspace/
// saved-view-filters.ts) on every save AND every load-and-apply — never
// raw query text or anything executable.
model SavedView {
  id         String              @id @default(cuid())
  name       String
  ownerId    String
  owner      User                @relation(fields: [ownerId], references: [id])
  visibility SavedViewVisibility @default(PRIVATE)
  isDefault  Boolean             @default(false)
  filters    Json
  archivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  scheduledReports ScheduledReport[]

  @@index([ownerId])
}

// Single-row table (id fixed at 1) for the two configurable Sales Workspace
// thresholds. Edited from Settings, gated by the existing manage_settings
// permission — no new permission needed for this.
model WorkspaceSettings {
  id                         Int      @id @default(1)
  noActivityThresholdDays    Int      @default(14)
  newlyAssignedThresholdDays Int      @default(3)
  updatedAt                  DateTime @updatedAt

  // Module Six Phase B: CAN-SPAM requires a valid physical mailing address
  // in every commercial email — resolved via the {{sender.mailingAddress}}
  // template placeholder rather than hardcoded per-template.
  mailingAddress String?

  // Module Nine: one business-wide quiet-hours window (BUSINESS_TIMEZONE-
  // relative, see src/lib/timezone.ts), applied to CRM-outreach sends only
  // (prepareSend/processDueScheduledEmail/sequence steps) — transactional/
  // system email (password reset, admin test-send) is exempt. Null on
  // either field = disabled, the default.
  quietHoursStartHour Int?
  quietHoursEndHour   Int?
}

// A report's filter configuration lives entirely in the existing SavedView
// (reused as-is, no changes to its schema or validated .strict() filter
// shape) — this table only carries what SavedView has no reason to hold:
// cadence, recipients, run status. See MODULE_5_REPORT.md for the
// scheduling design (one fixed hourly pg-boss tick + per-row dedup via
// singletonKey, not per-report native cron registration).
model ScheduledReport {
  id            String           @id @default(cuid())
  name          String
  reportKey     String // matches a /reports/[section] route, e.g. "pipeline" — never a stage/leadtype name
  savedViewId   String?
  savedView     SavedView?       @relation(fields: [savedViewId], references: [id])
  cadence       ReportCadence
  recipientIds  String[] // User ids, validated server-side against real users at save time
  active        Boolean          @default(true)
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  lastRunAt     DateTime?
  lastRunStatus ReportRunStatus?
  nextRunAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  generatedReports GeneratedReport[]

  @@index([active, nextRunAt])
  @@index([createdById])
}

// One row per actual report run — the source of truth for "download again"
// (reportKey/scheduledReportId/payload) and for access control
// (recipientIds). Through Phase D2 it also drove the notification-bell's
// unread state directly via a `seenByIds` column — Module Six Phase E
// removed that column and replaced it with the same mechanism every other
// event type in this app already uses: one Notification row per recipient
// (type REPORT_GENERATED, payload carrying generatedReportId), read-tracked
// via Notification.readAt. This is the "eventually one system instead of
// two" unification GeneratedReport's Phase-D1-era doc comment deferred —
// GeneratedReport itself still exists and still owns report *data*
// (unaffected), it just no longer separately tracks read state.
model GeneratedReport {
  id                String           @id @default(cuid())
  scheduledReportId String? // null = ad-hoc/manual export, not from a schedule
  scheduledReport   ScheduledReport? @relation(fields: [scheduledReportId], references: [id])
  reportKey         String
  status            ReportRunStatus
  // The exact business-timezone period this run covers, resolved once at
  // generation time — a "download again" next month must reproduce what was
  // actually generated, not silently re-resolve "this month" to a different
  // month. Required on every row (this table has never received a row
  // before this field was added, so there is no backfill to reconcile).
  periodStart       DateTime
  periodEnd         DateTime
  // Frozen at generation time: { columns: {key,label}[], rows: Record<string,string>[] }
  // (the exact shape src/lib/export/serialize.ts's builders take) — makes
  // "download" a pure serialization of already-computed data, never a live
  // re-query that could drift from what was actually generated or leak data
  // the original scope no longer permits.
  payload           Json
  recipientIds      String[]
  errorMessage      String?
  createdAt         DateTime         @default(now())

  // Module Ten: closes a real idempotency gap — generate-report.ts's worker
  // handler had no guard against a pg-boss redelivery duplicating this row
  // (and its fan-out Notifications) for the same schedule+period. Null
  // scheduledReportId (ad-hoc/manual exports) is exempt from this
  // constraint by ordinary SQL NULL semantics — multiple NULLs never
  // collide — which is correct, since only scheduled runs need this guard.
  @@unique([scheduledReportId, periodStart])
  @@index([scheduledReportId])
  @@index([createdAt])
}

enum ContactStatus {
  ACTIVE
  // Module Seven: absorbed into another Contact via a safe merge, mirroring
  // Company's MERGED tombstone convention. Contact had no status/archive
  // concept before this module — see mergeContacts() (src/lib/data-quality/
  // merge-contact.ts).
  MERGED
}

model Contact {
  id            String         @id @default(cuid())
  companyId     String
  firstName     String
  lastName      String
  title         String?
  phone         String?
  email         String?
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailMessages EmailMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Module Six Phase B: CASL-safe default-deny — a contact cannot receive
  // automated/composer email until a ConsentRecord establishes permission.
  // These two fields are a denormalized "current state" read alongside the
  // append-only ConsentRecord history, mirroring the exact
  // Company.currentHistoricalScoreId "current pointer" pattern from Module
  // One (full history in one table, fast current-state check on the row
  // itself).
  emailPermitted    Boolean         @default(false)
  doNotContact      Boolean         @default(false)
  unsubscribedAt    DateTime?
  unsubscribeSource String?
  consentRecords    ConsentRecord[]

  sequenceEnrollments SequenceEnrollment[]
  appointments        Appointment[]

  // Module Seven: matching normalization (see Company.normalizedRegion's
  // doc comment — same "populated going forward + self-healed by scan"
  // convention, own display fields never overwritten) and merge tombstone
  // (parallel to Company.status/mergedIntoId/mergedAt/mergedById). Every
  // pre-existing read site (contact list panels, pickers, search) must
  // filter status: ACTIVE explicitly — Contact had no status filter to
  // carry forward from before this module.
  normalizedFirstName String?
  normalizedLastName  String?
  normalizedPhone     String?
  normalizedEmail     String?

  status       ContactStatus @default(ACTIVE)
  mergedIntoId String?
  mergedInto   Contact?      @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Contact[]     @relation("ContactMerge")
  mergedAt     DateTime?
  mergedById   String?
  mergedBy     User?         @relation("ContactMerger", fields: [mergedById], references: [id], onDelete: SetNull)

  dataQualityIssues    DataQualityIssue[]
  duplicatesAsA        PotentialDuplicate[]    @relation("PotentialDuplicateContactA")
  duplicatesAsB        PotentialDuplicate[]    @relation("PotentialDuplicateContactB")
  enrichmentRecords    EnrichmentRecord[]
  dataQualityAuditRefs DataQualityAuditEvent[]

  @@index([normalizedFirstName, normalizedLastName])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([status])
  @@index([mergedIntoId])
  @@index([companyId, status])
}

model CompanySource {
  id         String   @id @default(cuid())
  companyId  String
  url        String
  title      String?
  evidence   String?
  verifiedAt DateTime
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model EvidenceRecord {
  id                 String                     @id @default(cuid())
  companyId          String
  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           ScoringCategory
  sourceType         String?
  sourceUrl          String?
  evidenceSummary    String                     @db.Text
  evidenceDate       DateTime?
  verificationStatus EvidenceVerificationStatus @default(UNVERIFIED)
  reliability        EvidenceReliability        @default(MEDIUM)
  createdById        String
  createdBy          User                       @relation("EvidenceCreator", fields: [createdById], references: [id])
  createdAt          DateTime                   @default(now())

  @@index([companyId, category])
}

// Append-only audit trail of EOS-1.0 scoring runs. Rows here are never
// updated or deleted once written; Company.currentHistoricalScoreId points
// at whichever row is presently "current" for fast listing.
model HistoricalScoreRecord {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("CompanyScoreHistory", fields: [companyId], references: [id], onDelete: Cascade)

  // Back-reference for the Company.currentHistoricalScoreId pointer above.
  currentForCompany Company? @relation("CurrentScore")

  eosTotal                       Int
  foodBeverageFocus              Int
  weeknightRevenueOpportunity    Int
  communityEngagement            Int
  existingEventCulture           Int
  groupSeatingLayout             Int
  capacityOperationalSuitability Int
  decisionMakerAccessibility     Int
  marketingActivityVisibility    Int
  turnkeyImplementationReadiness Int
  competitiveOpportunity         Int

  opportunityGrade         OpportunityGrade
  confidenceLevel          ConfidenceLevel
  primaryClassification    PrimaryClassification
  secondaryTags            SecondaryTag[]        @default([])
  salesPriorityScore       Int?
  scoreExplanation         String?               @db.Text
  recommendedSalesApproach String?               @db.Text
  recommendedNextAction    String?               @db.Text
  scoringVersion           String
  scoredAt                 DateTime              @default(now())

  // Either a human reviewer (scoredBy) or a named automated source
  // (scoringSource, e.g. a future AI engine identifier) — at least one
  // should be set, enforced at the application layer.
  scoredById    String?
  scoredBy      User?   @relation("ScoreAuthor", fields: [scoredById], references: [id])
  scoringSource String?

  @@index([companyId, scoredAt])
}

model Activity {
  id         String       @id @default(cuid())
  companyId  String
  userId     String
  type       ActivityType
  occurredAt DateTime     @default(now())
  notes      String?      @db.Text
  outcome    String?
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())
}

model Task {
  id           String     @id @default(cuid())
  companyId    String
  assignedToId String
  title        String
  notes        String?
  dueAt        DateTime
  status       TaskStatus @default(OPEN)
  completedAt  DateTime?
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo   User       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model PromptTemplate {
  id                  String       @id @default(cuid())
  name                String
  qualificationPrompt String       @db.Text
  archived            Boolean      @default(false)
  createdById         String
  createdBy           User         @relation(fields: [createdById], references: [id])
  searches            LeadSearch[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model LeadSearch {
  id             String            @id @default(cuid())
  promptId       String?
  createdById    String
  leadTypeId     String
  competitorId   String?
  country        String
  region         String
  cities         Json
  minimumScore   Int               @default(80)
  mode           LeadSearchMode    @default(GENERAL)
  promptSnapshot String            @db.Text
  prompt         PromptTemplate?   @relation(fields: [promptId], references: [id], onDelete: SetNull)
  createdBy      User              @relation(fields: [createdById], references: [id])
  leadType       LeadType          @relation(fields: [leadTypeId], references: [id])
  competitor     Competitor?       @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  results        SearchResult[]
  candidates     SearchCandidate[]
  usageRecords   AiUsageRecord[]

  // Durable job tracking — executed by the worker via a pg-boss job
  // (providerJobId), not inline in the web process. See run-search.ts and
  // worker/handlers/run-search.ts.
  status          SearchJobStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  heartbeatAt     DateTime?
  errorMessage    String?         @db.Text
  candidatesFound Int             @default(0)
  // Live "what's happening right now" text for the status page, updated as
  // discovery works through cities (see GooglePlacesDiscoveryProvider/
  // MockPlacesProvider's onProgress calls in run-search.ts) — the only
  // per-city checkpoint before this was the one bulk write at the very end
  // of discover(), which left the status page showing nothing for the
  // entire discovery phase of a multi-city search.
  progressMessage String?         @db.Text
  providerJobId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, heartbeatAt])
  @@index([providerJobId])
}

/**
 * One row per candidate returned by a single discover() call for a
 * LeadSearch, persisted immediately so the expensive/non-deterministic
 * discovery step is never re-run once its results are checkpointed. Status
 * advances PENDING -> VERIFIED -> SCORED -> COMPLETED as run-search.ts
 * processes each candidate; a resumed/retried job skips everything already
 * COMPLETED and re-enters at the first un-checkpointed stage, so a crash mid
 * -job can cause at most one extra provider call per candidate per retry,
 * never a duplicate SearchResult row (see SearchResult.candidateId).
 */
model SearchCandidate {
  id                 String                @id @default(cuid())
  searchId           String
  search             LeadSearch            @relation(fields: [searchId], references: [id], onDelete: Cascade)
  index              Int
  normalizedIdentity String
  rawCandidate       Json
  status             SearchCandidateStatus @default(PENDING)
  verifiedData       Json?
  score              Int?
  explanation        String?               @db.Text
  attempts           Int                   @default(0)
  lastError          String?               @db.Text
  result             SearchResult?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([searchId, normalizedIdentity])
  @@index([searchId, status])
}

model SearchResult {
  id                String                  @id @default(cuid())
  searchId          String
  companyId         String?
  rejectionReasonId String?
  competitorId      String?
  // Links back to the SearchCandidate this result was created from. Nullable
  // because rows created before this column existed have no candidate row;
  // every new result is upserted by candidateId so a retried job can never
  // create a duplicate (see SearchCandidate doc comment).
  candidateId       String?                 @unique
  candidate         SearchCandidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  name              String
  address1          String?
  city              String
  region            String
  postalCode        String?
  country           String
  phone             String?
  email             String?
  websiteUrl        String?
  contactData       Json?
  score             Int
  explanation       String                  @db.Text
  // Structured convention (no schema-level shape, defined at the app layer):
  // evidence = { category, note, sourceUrl, verificationStatus }[]
  // sources  = { url, title }[] flat citation list for quick display
  evidence          Json
  sources           Json
  triviaStatus      TriviaStatus            @default(UNCERTAIN)
  disposition       SearchResultDisposition @default(NEW)
  researchedAt      DateTime                @default(now())
  search            LeadSearch              @relation(fields: [searchId], references: [id], onDelete: Cascade)
  company           Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  rejectionReason   RejectionReason?        @relation(fields: [rejectionReasonId], references: [id], onDelete: SetNull)
  competitor        Competitor?             @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  // Mirrors Company's normalized columns — powers cross-search rejection
  // memory (findPriorRejectedMatches) since candidates aren't Company rows
  // yet when this matching needs to happen.
  normalizedName  String
  normalizedPhone String?
  normalizedEmail String?
  websiteDomain   String?

  @@index([searchId, score])
  @@index([normalizedName])
  @@index([websiteDomain])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([disposition])
}

model ImportTemplate {
  id              String   @id @default(cuid())
  name            String
  mapping         Json
  transformations Json?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/**
 * Durable replacement for the old in-memory upload preview store. `payload`
 * (the parsed spreadsheet rows) is nulled the moment it's no longer needed —
 * immediately after a successful commitImport, or by the worker's cleanup
 * job once expiresAt passes for a batch nobody committed. The row itself
 * (metadata only, once payload is null) is kept a further grace period for
 * troubleshooting, then hard-deleted. Never written with app-layer
 * encryption — see MODULE_3_REPORT.md for why plain Json was chosen.
 */
model ImportBatch {
  id           String            @id @default(cuid())
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  filename     String
  status       ImportBatchStatus @default(PENDING)
  headers      Json
  payload      Json?
  rowCount     Int
  mapping      Json?
  errorMessage String?           @db.Text
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  companies    Company[]

  @@index([status, expiresAt])
  @@index([uploadedById])
}

/**
 * One row per AI provider call (discover/verify/score/promptAssist),
 * written immediately after the call returns so cost is visible even if the
 * enclosing job later fails. Feeds the optional AI_DAILY_BUDGET_USD /
 * AI_MONTHLY_BUDGET_USD safeguard — see src/lib/research/providers/pricing.ts.
 */
model AiUsageRecord {
  id                  String      @id @default(cuid())
  searchId            String?
  search              LeadSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider            String
  operation           String
  model               String
  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int         @default(0)
  cacheCreationTokens Int         @default(0)
  serverToolUses      Int         @default(0)
  estimatedCostUsd    Decimal     @db.Decimal(10, 6)
  createdAt           DateTime    @default(now())

  @@index([createdAt])
  @@index([searchId])
}

/**
 * Fixed-window Postgres counter, shared by every process (web + every
 * worker instance) — replaces the old in-process, restart-losing token
 * bucket. key encodes the axis being limited, e.g. "login:ip:<ip>" or
 * "ai-provider:anthropic". See src/lib/rate-limit/postgres-bucket.ts.
 */
model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}

// ===== Module Six: Communications and Follow-up Automation (Phases A-B) =====

enum ProviderKind {
  MICROSOFT
  GOOGLE
}

enum ProviderConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

/**
 * One connected mailbox per user (unique on userId) — the brief's "connect
 * their own business mailbox," never a shared company mailbox. Microsoft
 * and Google both grant mail + calendar scopes in a single OAuth consent,
 * so this one row covers calendar access too (Phase D) rather than a
 * second connection model. Tokens are encrypted at rest
 * (src/lib/comms/token-crypto.ts, AES-256-GCM) — this table never stores a
 * plaintext token. tokenEncryptionKeyVersion supports rotating
 * TOKEN_ENCRYPTION_KEY later without a flag day.
 */
model ProviderConnection {
  id                        String                   @id @default(cuid())
  userId                    String                   @unique
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                  ProviderKind
  providerAccountEmail      String
  encryptedAccessToken      String                   @db.Text
  encryptedRefreshToken     String                   @db.Text
  tokenEncryptionKeyVersion Int                      @default(1)
  scopes                    String[]
  tokenExpiresAt            DateTime
  status                    ProviderConnectionStatus @default(CONNECTED)
  lastError                 String?
  lastSyncAt                DateTime?
  connectedAt               DateTime                 @default(now())
  disconnectedAt            DateTime?

  // Module Six Phase D2: inbound sync. inboundClientState is a per-
  // connection random secret this app generates and hands to the provider
  // when creating the subscription; the provider echoes it back on every
  // notification, and the webhook route rejects anything that doesn't
  // match — proof the notification actually came from a subscription this
  // app created, not a forged POST to the public webhook URL. It's a
  // shared secret analogous to a webhook signing secret, not a bearer
  // credential to the mailbox itself, so unlike the access/refresh tokens
  // above it isn't run through token-crypto.ts. Only ever populated for
  // Microsoft connections in this phase — see google.ts's inbound methods.
  inboundSubscriptionId        String?
  inboundSubscriptionExpiresAt DateTime?
  inboundClientState           String?

  emailMessages EmailMessage[]
  appointments  Appointment[]

  @@index([status])
}

enum EmailTemplateVisibility {
  PERSONAL
  SHARED
}

/**
 * Table-driven, editable templates — never hardcoded copy. Placeholder
 * syntax and unresolved-placeholder detection live in
 * src/lib/comms/templates.ts (a pure function, unit-tested standalone,
 * same spirit as src/lib/reports/metrics.ts). ownerId is null for a shared
 * template (visibility SHARED); set for a personal one.
 */
model EmailTemplate {
  id              String                  @id @default(cuid())
  name            String
  category        String?
  subject         String
  body            String                  @db.Text
  active          Boolean                 @default(true)
  visibility      EmailTemplateVisibility @default(PERSONAL)
  ownerId         String?
  owner           User?                   @relation("EmailTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  leadTypeId      String?
  leadType        LeadType?               @relation(fields: [leadTypeId], references: [id], onDelete: SetNull)
  pipelineStageId String?
  pipelineStage   PipelineStage?          @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  language        String                  @default("en")
  createdById     String
  createdBy       User                    @relation("EmailTemplateCreator", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?                   @relation("EmailTemplateUpdater", fields: [updatedById], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  emailMessages EmailMessage[]
  sequenceSteps SequenceStep[]

  @@index([visibility, active])
  @@index([ownerId])
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailMessageStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  CANCELLED
  REPLIED
  // Module Six Phase D2: an inbound message that arrived via webhook sync.
  // Deliberately its own value rather than overloading DELIVERED (which
  // means "an outbound send was confirmed delivered") or REPLIED (reserved
  // for a display-layer "this outbound message got a reply" marker, not
  // implemented yet) — see the inbound-sync doc comment below.
  RECEIVED
}

/**
 * One row per email in either direction — this is what the company/contact
 * Inbox tab renders, and (from Phase E) what delivery-status webhooks
 * update in place. Deliberately separate from Activity (the human-readable
 * audit trail already logs a plain-language "email sent" note via
 * logEmailSent — see src/lib/companies/activity-log.ts's existing
 * convention) — same split Module Five established for
 * PipelineStageHistory vs. the PIPELINE_CHANGE activity.
 * Phase D2 (inbound sync): companyId/contactId are nullable because an
 * inbound message from a sender address matching no Contact (or matching
 * more than one, across different companies) can't be attached to
 * anything yet — it lands with both null and reviewedAt/reviewedById null,
 * for authorized review at /settings/communications-review (the plan's
 * explicit "never auto-create a company from an unknown sender"
 * requirement). fromAddress is the raw inbound sender; null for outbound
 * rows, where the sender is implied by providerConnection.
 */
model EmailMessage {
  id                   String              @id @default(cuid())
  companyId            String?
  company              Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId            String?
  contact              Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  direction            EmailDirection      @default(OUTBOUND)
  providerConnectionId String?
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  fromAddress          String?
  toAddresses          String[]
  ccAddresses          String[]            @default([])
  bccAddresses         String[]            @default([])
  subject              String
  body                 String              @db.Text
  templateId           String?
  template             EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status               EmailMessageStatus  @default(DRAFT)
  scheduledFor         DateTime?
  sentAt               DateTime?
  providerMessageId    String?
  providerThreadId     String?
  errorMessage         String?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?               @relation("EmailMessageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?               @relation("EmailMessageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())

  sequenceStepRun SequenceStepRun?

  @@unique([providerConnectionId, providerMessageId])
  @@index([companyId])
  @@index([contactId])
  @@index([status, scheduledFor])
  @@index([direction, reviewedAt])
}

/**
 * Notification-level idempotency for inbound webhook delivery — a provider
 * may redeliver the same notification (Graph and Google both document this
 * as expected, not a bug), and this table makes a redelivery a cheap no-op
 * before any Graph/Google API call is even made to fetch the message
 * content. providerEventId is synthesized per provider (Graph doesn't
 * issue a single canonical notification id): see
 * src/lib/comms/inbound-sync.ts's buildWebhookEventId(). This is separate
 * from, and a first line of defense ahead of, EmailMessage's own
 * (providerConnectionId, providerMessageId) unique constraint, which
 * catches a duplicate at the message-content level too.
 */
model WebhookEvent {
  id              String       @id @default(cuid())
  provider        ProviderKind
  providerEventId String
  receivedAt      DateTime     @default(now())

  @@unique([provider, providerEventId])
}

enum ConsentType {
  EXPRESS
  IMPLIED
  WITHDRAWN
}

/**
 * Append-only — mirrors the exact HistoricalScoreRecord pattern from Module
 * One (full history here; Contact.emailPermitted/doNotContact are the
 * denormalized "current state" fields computed at write time, same split
 * as Company.currentHistoricalScoreId). A new record is never deleted or
 * edited, including a WITHDRAWN one from a self-service unsubscribe click
 * (recordedById is null in that case — no user performed the action).
 * This is compliance evidence, not just a status field: source/note/
 * occurredAt document *why* consent is believed to exist, for CASL/
 * CAN-SPAM record-keeping.
 */
model ConsentRecord {
  id           String      @id @default(cuid())
  contactId    String
  contact      Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type         ConsentType
  source       String
  note         String?
  occurredAt   DateTime    @default(now())
  recordedById String?
  recordedBy   User?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([contactId, occurredAt])
}

// ===== Module Six Phase C: scheduling and follow-up sequences =====

enum SequenceStepType {
  WAIT
  EMAIL
  TASK
  CALL_REMINDER
  DEMO_REMINDER
  TRIAL_FOLLOWUP
}

/**
 * A table-driven, admin-authored step list — never generated or recursive
 * — so a sequence terminates in at most `steps.length` ticks-worth of
 * processing (see the approved plan's "no uncontrolled loops" requirement).
 * WAIT has no side effect of its own; it only delays how long after the
 * previous step the next actionable (EMAIL/TASK-like) step becomes due —
 * see src/lib/comms/sequences.ts for the due-date computation. The other
 * five types are "actionable": EMAIL sends via the same sendEmail() gate
 * every other send path shares; the four TASK-like types create a real
 * Task row (src/app/(dashboard)/companies/[id]/tasks), reusing the
 * existing follow-up infrastructure rather than a parallel one.
 */
model SequenceStep {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepOrder  Int
  type       SequenceStepType

  waitDays        Int?
  emailTemplateId String?
  emailTemplate   EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  taskTitle       String?
  taskNotes       String?        @db.Text

  stepRuns SequenceStepRun[]

  @@unique([sequenceId, stepOrder])
}

/**
 * A sequence-level (not per-step) stop condition: reaching this pipeline
 * stage ends every active enrollment in this sequence, checked by the tick
 * before running any step (src/lib/comms/sequences.ts). Kept at the
 * sequence level rather than duplicated per step — the plan's schema
 * sketch put this on SequenceStep, but "which stage ends the sequence" is
 * one decision per sequence, not one the author should have to repeat on
 * every step.
 */
model FollowUpSequence {
  id                    String         @id @default(cuid())
  name                  String
  active                Boolean        @default(true)
  stopOnPipelineStageId String?
  stopOnPipelineStage   PipelineStage? @relation(fields: [stopOnPipelineStageId], references: [id], onDelete: SetNull)
  createdById           String
  createdBy             User           @relation(fields: [createdById], references: [id])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]
}

enum SequenceEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  STOPPED_OPT_OUT
  STOPPED_STAGE
  STOPPED_REPLY
}

/**
 * Explicit enrollment only — created by a user action after previewing
 * every step (no automatic/batch enrollment path anywhere in this schema).
 * `currentStepOrder` always points at the next actionable step to run;
 * `nextStepDueAt` is when the tick should run it. `STOPPED_REPLY` exists
 * on the enum for schema completeness across the whole plan but is
 * unreachable until Phase D adds inbound reply detection — this phase can
 * only ever produce STOPPED_OPT_OUT/STOPPED_STAGE, never STOPPED_REPLY.
 */
model SequenceEnrollment {
  id         String                   @id @default(cuid())
  sequenceId String
  sequence   FollowUpSequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status     SequenceEnrollmentStatus @default(ACTIVE)

  currentStepOrder Int
  nextStepDueAt    DateTime?

  enrolledById String
  enrolledBy   User      @relation(fields: [enrolledById], references: [id])
  enrolledAt   DateTime  @default(now())
  stoppedAt    DateTime?
  stopReason   String?

  stepRuns SequenceStepRun[]

  @@index([status, nextStepDueAt])
}

enum SequenceStepRunStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

/**
 * One row per attempted step, `@@unique([enrollmentId, stepId])` — the
 * duplicate-send-prevention mechanism, playing the exact role Module
 * Five's pg-boss `singletonKey` dedup plays for scheduled reports: a step
 * can be offered by multiple ticks (worker restart, slow processing)
 * without ever executing twice, without new locking code.
 */
model SequenceStepRun {
  id           String                @id @default(cuid())
  enrollmentId String
  enrollment   SequenceEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         SequenceStep          @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status       SequenceStepRunStatus @default(PENDING)
  runAt        DateTime              @default(now())

  emailMessageId String?       @unique
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)
  errorMessage   String?

  @@unique([enrollmentId, stepId])
}

// ===== Module Six Phase D1: calendar and appointments =====

enum AppointmentType {
  DEMO
  TRIAL_REVIEW
  FOLLOW_UP
}

enum AppointmentStatus {
  SCHEDULED
  UPDATED
  CANCELLED
  ERROR
}

/**
 * One appointment on a connected calendar (Microsoft/Google — same
 * ProviderConnection Phase A already established, since both providers
 * grant calendar scope in the same OAuth consent as mail). `startAt`/
 * `endAt` are real UTC instants; `timezone` (an IANA name) is what the
 * provider is told to display them in — Microsoft Graph specifically
 * requires wall-clock-in-that-zone strings, not UTC, for its event body
 * (see src/lib/comms/calendar-time.ts). `providerEventId` is null only
 * when creation itself failed (`status: ERROR`) — never claim a real
 * provider-side event exists when it doesn't.
 */
model Appointment {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type      AppointmentType
  title     String
  startAt   DateTime
  endAt     DateTime
  timezone  String

  attendeeEmails String[]

  providerConnectionId String?
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  providerEventId      String?
  status               AppointmentStatus   @default(SCHEDULED)
  lastError            String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([providerConnectionId])
}

enum NotificationType {
  NEW_REPLY
  DELIVERY_FAILURE
  APPOINTMENT_ACCEPTED
  APPOINTMENT_DECLINED
  SEQUENCE_COMPLETED
  SEQUENCE_PAUSED
  PROVIDER_DISCONNECTED
  FOLLOW_UP_DUE
  SCHEDULED_EMAIL_FAILED
  // Module Six Phase E: a sent message bounced, detected via inbound sync
  // recognizing a Non-Delivery Report referencing it — see
  // src/lib/comms/inbound-sync.ts's isBounceMessage()/linkBounceToOriginalSend().
  // Deliberately its own type rather than reusing DELIVERY_FAILURE: that
  // type means "the provider call itself failed" (never even accepted for
  // delivery); a bounce means the provider accepted and attempted delivery,
  // then it failed downstream — a materially different, more specific
  // signal worth distinguishing in the bell.
  EMAIL_BOUNCED
  // Module Six Phase E: replaces GeneratedReport.seenByIds as the
  // notification-bell's read-tracking mechanism for report generation —
  // see GeneratedReport's doc comment for the unification this completes.
  REPORT_GENERATED
}

/**
 * The general-purpose notification model this codebase didn't have before
 * (Module Five's GeneratedReport.seenByIds is deliberately report-specific
 * — see its own doc comment). payload carries type-specific display data
 * (e.g. { companyId, companyName } for NEW_REPLY) so the bell can render
 * and link without a second query per notification.
 */
model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  payload     Json
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, readAt])
}

// ===== Module Seven: Data Quality, Duplicate Management, Record Merging,
// and Enrichment History =====

enum DataQualityEntityType {
  COMPANY
  CONTACT
}

enum DataQualityRuleType {
  REQUIRED_FIELD
  INVALID_EMAIL_FORMAT
  INVALID_PHONE_FORMAT
  INVALID_URL_FORMAT
  DUPLICATE_EXACT_MATCH
  DUPLICATE_NORMALIZED_MATCH
  DUPLICATE_FUZZY_MATCH
  STALE_RECORD
  CUSTOM_REVIEW_FLAG
}

enum DataQualitySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DataQualityIssueStatus {
  OPEN
  DEFERRED
  RESOLVED
  IGNORED
  REOPENED
}

enum DuplicateReviewStatus {
  PENDING
  NOT_DUPLICATE
  CONFIRMED
  DEFERRED
  MERGED
}

enum EnrichmentDecision {
  PENDING
  ACCEPTED
  REJECTED
}

enum DataQualityAuditAction {
  RULE_CREATED
  RULE_UPDATED
  RULE_ARCHIVED
  RULE_RESTORED
  ISSUE_STATUS_CHANGED
  ISSUE_ASSIGNED
  ISSUE_BULK_UPDATED
  RECORD_CORRECTED
  DUPLICATE_REVIEWED
  COMPANY_MERGED
  CONTACT_MERGED
  SCAN_STARTED
  SCAN_COMPLETED
  SCAN_FAILED
  SCAN_CANCELLED
  ENRICHMENT_SUGGESTED
  ENRICHMENT_ACCEPTED
  ENRICHMENT_REJECTED
}

/**
 * Table-driven, editable data-quality rules — never hardcoded checks.
 * `field` names the record field being checked (meaningful for
 * REQUIRED_FIELD/INVALID_*_FORMAT/STALE_RECORD; largely unused for the
 * DUPLICATE_* types, which compare several fields at once per
 * src/lib/data-quality/company-match.ts / contact-match.ts). `config` is
 * validated per-ruleType by DataQualityRuleConfigSchema (src/lib/
 * data-quality/rules.ts, a Zod discriminated union) before every save —
 * structured data, never trusted raw. Archived rather than deleted
 * (archivedAt nullable timestamp only — same convention as SavedView),
 * since an issue/duplicate a since-archived rule already produced must
 * stay explainable.
 */
model DataQualityRule {
  id          String                @id @default(cuid())
  name        String
  description String?               @db.Text
  entityType  DataQualityEntityType
  field       String
  ruleType    DataQualityRuleType
  severity    DataQualitySeverity   @default(MEDIUM)
  enabled     Boolean               @default(true)
  sortOrder   Int                   @default(0)
  config      Json                  @default("{}")
  archivedAt  DateTime?
  createdById String
  createdBy   User                  @relation("DataQualityRuleCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?                 @relation("DataQualityRuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  issues DataQualityIssue[]

  @@index([entityType, enabled, archivedAt])
  @@index([ruleType])
}

/**
 * One row per (record, rule) violation — upserted by the scan
 * (src/lib/data-quality/scan.ts), never duplicated across re-scans. A
 * record that stops violating a rule is auto-resolved (status: RESOLVED,
 * resolutionAction: "auto: rule no longer applies") rather than deleted, so
 * the resolution itself stays in the workflow history. Exactly one of
 * companyId/contactId is set, matching entityType — enforced at the
 * application layer (see evaluateRule()).
 */
model DataQualityIssue {
  id               String                 @id @default(cuid())
  entityType       DataQualityEntityType
  companyId        String?
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          Contact?               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  ruleId           String
  rule             DataQualityRule        @relation(fields: [ruleId], references: [id])
  field            String
  // Own copy, snapshotted at detection time — a later edit to the rule's
  // configured severity must not silently rewrite the history of an
  // already-detected issue.
  severity         DataQualitySeverity
  status           DataQualityIssueStatus @default(OPEN)
  description      String                 @db.Text
  detectedAt       DateTime               @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?                  @relation("DataQualityIssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionAction String?
  assignedToId     String?
  assignedTo       User?                  @relation("DataQualityIssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes            String?                @db.Text
  updatedAt        DateTime               @updatedAt

  @@unique([companyId, ruleId])
  @@unique([contactId, ruleId])
  @@index([entityType, status, severity])
  @@index([assignedToId])
  @@index([status, detectedAt])
}

/**
 * A candidate duplicate pair (Section 5/8 of the plan) — pairwise, not
 * n-way grouped, matching the existing findPotentialDuplicates() precedent
 * (src/lib/duplicates/match.ts) and keeping merge UX tractable; 3+
 * overlapping duplicates surface as multiple reviewable pairs. Only the
 * companyA/B or contactA/B pair matching `entityType` is ever populated —
 * always stored in canonical lower-id-first order so the unique
 * constraints actually dedupe re-detection of the same pair. `confidence`
 * reuses the existing ConfidenceLevel enum. `dismissedFieldsSnapshot`
 * captures the matched fields' values at the moment of a NOT_DUPLICATE
 * decision; a later scan compares current values against it and, if any
 * meaningfully differ, flips status back to PENDING for reconsideration
 * (never re-suggests an unchanged dismissed pair — see runDataQualityScan).
 */
model PotentialDuplicate {
  id         String                @id @default(cuid())
  entityType DataQualityEntityType

  companyAId String?
  companyA   Company? @relation("PotentialDuplicateCompanyA", fields: [companyAId], references: [id], onDelete: Cascade)
  companyBId String?
  companyB   Company? @relation("PotentialDuplicateCompanyB", fields: [companyBId], references: [id], onDelete: Cascade)

  contactAId String?
  contactA   Contact? @relation("PotentialDuplicateContactA", fields: [contactAId], references: [id], onDelete: Cascade)
  contactBId String?
  contactB   Contact? @relation("PotentialDuplicateContactB", fields: [contactBId], references: [id], onDelete: Cascade)

  score                   Int
  confidence              ConfidenceLevel
  reasons                 String[]
  matchedFields           String[]
  conflictingFields       String[]
  status                  DuplicateReviewStatus @default(PENDING)
  dismissedFieldsSnapshot Json?
  assignedToId            String?
  assignedTo              User?                 @relation("PotentialDuplicateAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reviewNote              String?               @db.Text
  detectedAt              DateTime              @default(now())
  lastSeenAt              DateTime              @default(now())
  reviewedAt              DateTime?
  reviewedById            String?
  reviewedBy              User?                 @relation("PotentialDuplicateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([companyAId, companyBId])
  @@unique([contactAId, contactBId])
  @@index([entityType, status, score])
  @@index([assignedToId])
}

/**
 * Job-tracking row for one data-quality scan run, deliberately mirroring
 * LeadSearch's shape (src/lib/research/run-search.ts) — reuses the
 * existing SearchJobStatus enum rather than a new one.
 * lastProcessedCompanyId/lastProcessedContactId are resumable keyset-
 * pagination cursors (see runDataQualityScan, src/lib/data-quality/
 * scan.ts): a crash/retry resumes from the cursor instead of restarting,
 * the same restart-safety guarantee run-search.ts gives per-candidate,
 * applied here per-batch since this scan is cheap local computation, not
 * expensive billed provider calls.
 */
model DataQualityScan {
  id                     String                 @id @default(cuid())
  entityType             DataQualityEntityType?
  status                 SearchJobStatus        @default(PENDING)
  startedAt              DateTime?
  completedAt            DateTime?
  heartbeatAt            DateTime?
  errorMessage           String?                @db.Text
  recordsScanned         Int                    @default(0)
  issuesFound            Int                    @default(0)
  duplicatesFound        Int                    @default(0)
  lastProcessedCompanyId String?
  lastProcessedContactId String?
  triggeredById          String?
  triggeredBy            User?                  @relation("DataQualityScanTrigger", fields: [triggeredById], references: [id], onDelete: SetNull)
  providerJobId          String?
  createdAt              DateTime               @default(now())

  @@index([status, heartbeatAt])
  @@index([providerJobId])
}

/**
 * Append-only enrichment suggestion + provenance, structurally mirroring
 * HistoricalScoreRecord/ConsentRecord's "full history, never edited after
 * the fact" convention. A suggestion never auto-applies — decision starts
 * PENDING and is only ever moved to ACCEPTED/REJECTED by an explicit user
 * action (src/app/(dashboard)/data-quality/enrichment/actions.ts), which
 * also performs the actual field write via the record-correction path
 * (Section 10) when accepted. A rejected suggestion is kept, never deleted,
 * for audit. `provider` mirrors AiUsageRecord.provider's plain-string
 * convention; only "mock" is implemented in this module (src/lib/
 * enrichment/providers/mock.ts) — no real provider, no live calls, no cost.
 */
model EnrichmentRecord {
  id               String                @id @default(cuid())
  entityType       DataQualityEntityType
  companyId        String?
  company          Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field            String
  previousValue    String?
  suggestedValue   String
  provider         String
  sourceUrl        String?
  evidence         String?               @db.Text
  confidence       ConfidenceLevel
  requestId        String?
  suggestedAt      DateTime              @default(now())
  decision         EnrichmentDecision    @default(PENDING)
  decidedAt        DateTime?
  decidedById      String?
  decidedBy        User?                 @relation("EnrichmentDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  estimatedCostUsd Decimal?              @db.Decimal(10, 6)

  @@index([entityType, decision])
  @@index([companyId])
  @@index([contactId])
  @@index([requestId])
}

/**
 * The one generic, cross-cutting audit log this codebase introduces —
 * every other audit trail in this app is a typed table purpose-built for
 * one kind of event (Activity, PipelineStageHistory, ConsentRecord). This
 * module needs to audit six structurally different action kinds (rule
 * changes, review decisions, corrections, merges, scans, enrichment
 * decisions) uniformly, which a single typed table can't do cleanly.
 * beforeData/afterData carry full snapshots — this is where a merge's
 * required "before/after data... field decisions" audit trail actually
 * lives (see mergeCompanies()/mergeContacts(), src/lib/data-quality/
 * merge-company.ts / merge-contact.ts). actorId is null for a
 * system/worker-initiated event (e.g. SCAN_STARTED from a tick — though
 * this module has no recurring tick, a future one could).
 */
model DataQualityAuditEvent {
  id                   String                 @id @default(cuid())
  action               DataQualityAuditAction
  actorId              String?
  actor                User?                  @relation("DataQualityAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  companyId            String?
  company              Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId            String?
  contact              Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ruleId               String?
  issueId              String?
  potentialDuplicateId String?
  enrichmentRecordId   String?
  beforeData           Json?
  afterData            Json?
  metadata             Json?
  occurredAt           DateTime               @default(now())

  @@index([action, occurredAt])
  @@index([companyId])
  @@index([contactId])
}

// ===== Module 8A: Essential Version 1 Administration =====

/**
 * The app's first genuinely generic, cross-module audit log — deliberately
 * separate from Module Seven's DataQualityAuditEvent (confirmed with the
 * user rather than generalizing that model): DataQualityAuditEvent has real
 * FKs into Company/Contact and a fixed, Module-Seven-specific action enum,
 * both wrong fits for auditing User/Role/OrganizationSettings/AiSettings
 * changes. entityType/entityId are loose strings, not FKs — this table must
 * never gain a hard dependency on any one domain model, since its whole
 * purpose is being usable from every admin surface. No update/delete action
 * for this model exists anywhere in the codebase — that absence of a code
 * path is what makes rows "cannot be modified or deleted through the
 * application" true, the same guarantee DataQualityAuditEvent relies on.
 */
model AuditEvent {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  module        String
  action        String
  entityType    String?
  entityId      String?
  // A blocked/failed attempt (e.g. "tried to demote the last
  // Administrator") is recorded too, not only successes — the audit log
  // must show what was *attempted*, not just what changed.
  success       Boolean  @default(true)
  // Shared by every row written as part of one logical multi-step
  // operation (e.g. an ownership transfer writes one row for the company
  // reassignment and one for the task reassignment) so they can be viewed
  // together — see src/lib/audit/log.ts's newCorrelationId().
  correlationId String?
  beforeData    Json?
  afterData     Json?
  metadata      Json?
  occurredAt    DateTime @default(now())

  @@index([occurredAt])
  @@index([actorId])
  @@index([module, action])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([success])
}

/**
 * Single-organization settings row (id fixed at 1, same upsert-by-id-1
 * idiom as WorkspaceSettings below) — deliberately does NOT duplicate
 * WorkspaceSettings' fields (noActivityThresholdDays/mailingAddress stay
 * exactly where they are); this owns genuinely distinct org-identity/
 * locale-default fields. No multi-tenancy: there is exactly one row, ever.
 */
model OrganizationSettings {
  id                     Int            @id @default(1)
  organizationName       String
  defaultCountry         String
  defaultRegion          String?
  defaultTimezone        String
  defaultCurrency        String
  defaultDateFormat      String
  defaultPipelineStageId String?
  defaultPipelineStage   PipelineStage? @relation(fields: [defaultPipelineStageId], references: [id], onDelete: SetNull)
  defaultLeadTypeId      String?
  defaultLeadType        LeadType?      @relation(fields: [defaultLeadTypeId], references: [id], onDelete: SetNull)
  businessPhone          String?
  businessEmail          String?
  businessWebsite        String?
  businessAddress        String?        @db.Text
  updatedAt              DateTime       @updatedAt
  updatedById            String?
  updatedBy              User?          @relation("OrganizationSettingsEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

/**
 * Single-row, DB-backed AI configuration — the runtime source of truth for
 * budget enforcement (src/lib/ai/budget.ts), replacing the previously-inert
 * AI_DAILY_BUDGET_USD/AI_MONTHLY_BUDGET_USD env vars (declared and
 * validated in src/lib/env.ts but never actually read anywhere before this
 * module). Those env vars, if set, only seed this row's initial values —
 * afterward this table is authoritative and editable without a redeploy.
 * approvedModel is validated against a small allowlist
 * (src/lib/ai/budget.ts) that currently has exactly one entry
 * ("claude-sonnet-5", the only model src/lib/research/providers/pricing.ts
 * can price) — a real, enforced setting, not a decorative one.
 */
model AiSettings {
  id                      Int      @id @default(1)
  researchEnabled         Boolean  @default(true)
  approvedModel           String   @default("claude-sonnet-5")
  defaultMinimumScore     Int      @default(80)
  maxCitiesPerSearch      Int      @default(50)
  maxResultsPerSearch     Int?
  dailyBudgetUsd          Decimal? @db.Decimal(10, 2)
  monthlyBudgetUsd        Decimal? @db.Decimal(10, 2)
  warningThresholdUsd     Decimal? @db.Decimal(10, 2)
  perUserDailySearchLimit Int?
  // Module Nine: hard $ ceiling for a single search, rechecked mid-run
  // (between candidates) — not just at start — so a search that crosses this
  // partway through stops immediately rather than finishing at full cost.
  // Null = unlimited (same convention as maxResultsPerSearch).
  maxCostPerSearchUsd     Decimal? @db.Decimal(10, 2)
  // Module Ten: caps web_search/web_fetch max_uses per Anthropic discovery
  // and verification call (src/lib/research/providers/anthropic.ts) —
  // previously hardcoded to 8 for both tools. Lower = faster but thinner
  // evidence per lead; higher = more thorough but slower. Admin-adjustable
  // so this tradeoff doesn't require a code change.
  maxSearchToolUsesPerCall Int     @default(8)
  updatedAt               DateTime @updatedAt
  updatedById             String?
  updatedBy               User?    @relation("AiSettingsEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

/**
 * A genuine worker heartbeat — nothing in this codebase read pg-boss's own
 * job-state tables or tracked worker liveness before this module. Touched
 * only by the new worker-heartbeat-tick (every 2 minutes, worker/main.ts),
 * the same createQueue/boss.schedule/boss.work idiom every other tick job
 * already uses. System Health (src/app/(dashboard)/administration/
 * system-health/) reads freshness relative to now — stale means the worker
 * process isn't running, not a guess from indirect signals.
 */
model WorkerHeartbeat {
  id        Int      @id @default(1)
  updatedAt DateTime @updatedAt
}

/**
 * Module Ten: tracks whether a "worker heartbeat is stale" alert email has
 * already been sent for the CURRENT stale episode — deliberately a separate
 * singleton row from WorkerHeartbeat itself, never the same row. Updating
 * WorkerHeartbeat directly would bump its @updatedAt on every write, which
 * would make the heartbeat look freshly-ticked even though the worker never
 * actually ticked, corrupting the exact signal System Health and this
 * alert both depend on.
 */
model WorkerHeartbeatAlert {
  id               Int       @id @default(1)
  staleAlertSentAt DateTime?
}

enum PasswordResetRequestResolution {
  LINK_GENERATED
  DISMISSED
}

/**
 * Self-service "forgot password" queue entry — created anonymously from
 * /forgot-password by email lookup only (never reveals whether the email
 * matched, and never itself carries a secret). An administrator with
 * manage_users sees pending requests on /settings/users and either generates
 * a one-time reset link (see generatePasswordResetLink()) or dismisses the
 * request. Module Nine added an optional transactional-email send of the
 * generated link (TransactionalEmailMessage, IntegrationSettings.
 * emailSendingEnabled) — but that's best-effort and off by default, so the
 * admin-mediated relay path documented here remains the reliable fallback
 * either way.
 */
model PasswordResetRequest {
  id           String                          @id @default(cuid())
  userId       String
  user         User                            @relation("PasswordResetRequestsForUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedAt  DateTime                        @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?                           @relation("PasswordResetRequestsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   PasswordResetRequestResolution?

  @@index([userId])
  @@index([requestedAt])
}

/**
 * A single-use, short-lived reset token. Only its SHA-256 hash is ever
 * persisted (same pattern as Session.tokenHash) — the raw value is returned
 * exactly once, to the administrator who generates it via
 * generatePasswordResetLink(), for them to relay to the user out of band. It
 * is never written to AuditEvent or any log.
 */
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("PasswordResetTokensForUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   User?     @relation("PasswordResetTokensCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Module Nine: Essential Version 1 Integrations.
//
// A new, narrowly-scoped transactional email provider (Resend) for
// system/account email only — password-reset links and an admin "send test
// email" action. This is deliberately separate from EmailMessage/
// ProviderConnection (Module Six's per-user OAuth mailbox model for
// CRM-outreach email, which is untouched by this module): a transactional
// send has no Contact/Company to attach to, no per-user mailbox to send
// through, and needs real delivery/bounce/complaint webhooks that a
// delegated Graph/Gmail mailbox structurally cannot provide.
model IntegrationSettings {
  id                  Int      @id @default(1)
  // Kill switch — false until an administrator explicitly enables it, even
  // once RESEND_API_KEY is configured. Mock mode (EMAIL_PROVIDER=mock, the
  // default) ignores this flag entirely so dev/tests never need it flipped.
  emailSendingEnabled Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  updatedById         String?
  updatedBy           User?    @relation("IntegrationSettingsEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

enum TransactionalEmailPurpose {
  PASSWORD_RESET
  ADMIN_TEST
  SYSTEM_ALERT
}

enum TransactionalEmailStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  COMPLAINED
  DEFERRED
}

/**
 * One row per transactional-send attempt. idempotencyKey is enforced unique
 * so a retried enqueue (see QUEUE_SEND_SYSTEM_EMAIL) can never double-send;
 * providerMessageId is enforced unique so the Resend delivery-events webhook
 * (EmailDeliveryEvent below) has a safe, collision-free lookup key.
 */
model TransactionalEmailMessage {
  id                String                    @id @default(cuid())
  purpose           TransactionalEmailPurpose
  toAddress         String
  subject           String
  // Plain-text body — the sole source of truth persisted between enqueue
  // (sendSystemEmail) and the worker actually calling the provider
  // (processQueuedSystemEmail). Safe HTML is derived from this at send time
  // via textToSafeHtml(), not stored separately.
  body              String                    @db.Text
  status            TransactionalEmailStatus  @default(QUEUED)
  idempotencyKey    String                    @unique
  providerMessageId String?                   @unique
  errorMessage      String?
  failureCategory   String?
  sentAt            DateTime?
  // Null for system-triggered sends (password reset has no acting admin);
  // set for an admin's own test send.
  createdById       String?
  createdBy         User?                     @relation("TransactionalEmailSender", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now())

  @@index([createdAt])
  @@index([toAddress])
}

/**
 * Addresses suppressed by a hard bounce or spam complaint reported through
 * the Resend delivery-events webhook (or a manual admin action). Checked by
 * sendSystemEmail() before every transactional send. Deliberately separate
 * from Contact.doNotContact — this suppresses the transactional/system-email
 * channel only, not CRM outreach, and the two recipient universes (staff
 * users vs. leads) are usually disjoint anyway.
 */
model EmailSuppression {
  id        String   @id @default(cuid())
  address   String   @unique
  reason    String
  source    String
  createdAt DateTime @default(now())
}

/**
 * Idempotency ledger for the Resend delivery-events webhook — same two-layer
 * pattern as WebhookEvent (Module Six's inbound-mail webhook), kept as its
 * own model rather than widening WebhookEvent's `provider: ProviderKind`
 * enum, since that enum means "OAuth mailbox kind" (MICROSOFT|GOOGLE)
 * elsewhere and Resend isn't one.
 */
model EmailDeliveryEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
}
